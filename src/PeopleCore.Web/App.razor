<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(PeopleCore.Web.Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(PeopleCore.Web.Layout.MainLayout)">
                <PageTitle>Not Found</PageTitle>
                <PageHeader Title="Page not found" Description="Sorry, there's nothing at this address." />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
