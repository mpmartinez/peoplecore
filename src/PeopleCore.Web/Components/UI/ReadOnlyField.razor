@namespace PeopleCore.Web.Components.UI

@*
    A labeled, non-editable value - for figures a server derives and a form must display but
    never let the user submit back (see Bir2316.razor's "Derived figures" panel). Deliberately
    not an Input with Disabled="true": a disabled input still submits with a form post and still
    looks editable at a glance, both of which are exactly the impressions this component exists
    to avoid.
*@
<div data-readonly-field>
    <div class="text-xs text-muted-foreground">@Label</div>
    <div class="@(Bold ? "font-semibold" : "")">@Value</div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="text-xs text-muted-foreground" data-hint>@Hint</p>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Bold { get; set; }
    /// <summary>A short note under the value on what the figure is, e.g. what it's net of.</summary>
    [Parameter] public string? Hint { get; set; }
}
