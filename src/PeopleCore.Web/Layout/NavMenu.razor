@using Microsoft.AspNetCore.Components.Authorization
@using PeopleCore.Web.Components.UI.Sidebar
@implements IDisposable
@inject NavigationManager Nav

@*
    The application's navigation, described once as data and rendered through the shadcn
    sidebar primitives. Adding a destination means adding a row to Sections below — the
    markup, the active state and the collapsed-rail behaviour come for free.
*@

@foreach (var section in Sections)
{
    if (section.AnyOf is null)
    {
        @RenderSection(section)
    }
    else
    {
        <PermissionView AnyOf="@section.AnyOf">
            @RenderSection(section)
        </PermissionView>
    }
}

@code {
    /// <summary>A menu link, shown to anyone who can see its section - or, when <paramref name="AnyOf"/> is set, only to holders of one of those.</summary>
    private sealed record NavEntry(string Href, string Label, string Icon, bool Exact = false, string[]? AnyOf = null);

    /// <summary>A menu section, shown to anyone holding any of <paramref name="AnyOf"/>, or to everyone when null.</summary>
    private sealed record NavSection(string Label, string[]? AnyOf, NavEntry[] Entries);

    private static readonly NavSection[] Sections =
    [
        new("My HR", null,
        [
            new("/", "Dashboard", "bi-house", Exact: true),
            new("/my-profile", "My Profile", "bi-person-circle"),
            new("/my-attendance", "Attendance", "bi-clock"),
            new("/my-leave", "Leave", "bi-calendar-check"),
            new("/my-payslips", "Payslips", "bi-receipt")
        ]),
        new("Organization", [Permissions.OrganizationManage],
        [
            new("/departments", "Departments", "bi-building"),
            new("/positions", "Positions", "bi-briefcase")
        ]),
        new("Employees", [Permissions.EmployeesViewAll],
        [
            new("/employees", "All Employees", "bi-people"),
            new("/separations", "Separations", "bi-box-arrow-right")
        ]),
        new("Time", [Permissions.AttendanceManage],
        [
            new("/attendance-records", "Attendance Records", "bi-calendar-week"),
            new("/attendance-import", "Import Attendance", "bi-upload")
        ]),
        new("Management", [Permissions.ApprovalsTeam, Permissions.ApprovalsAll],
        [
            new("/leave-approvals", "Leave Approvals", "bi-check-square"),
            new("/overtime-approvals", "OT Approvals", "bi-clock-history"),
            new("/attendance-corrections", "Attendance Corrections", "bi-pencil-square"),
            new("/performance", "Performance", "bi-bar-chart")
        ]),
        new("Payroll", [Permissions.PayrollManage],
        [
            new("/payroll-runs", "Payroll Runs", "bi-cash-stack"),
            new("/bir-2316", "BIR Form 2316", "bi-file-earmark-text"),
            new("/government-reports", "Government Reports", "bi-bank")
        ]),
        new("Recruitment", [Permissions.RecruitmentManage],
        [
            new("/job-postings", "Job Postings", "bi-file-text"),
            new("/applicants", "Applicants", "bi-person-plus")
        ]),
        new("Analytics", [Permissions.AnalyticsHr],
        [
            new("/analytics", "Analytics", "bi-graph-up")
        ]),
        new("Administration", [Permissions.UsersManage, Permissions.RolesManage, Permissions.SettingsManage],
        [
            new("/admin/users", "Users", "bi-person-gear", AnyOf: [Permissions.UsersManage]),
            new("/admin/roles", "Roles", "bi-shield-lock", AnyOf: [Permissions.RolesManage]),
            new("/admin/company", "Company", "bi-building", AnyOf: [Permissions.SettingsManage]),
            new("/admin/email", "Email", "bi-envelope", AnyOf: [Permissions.SettingsManage])
        ])
    ];

    [CascadingParameter] public ShadcnSidebar? Sidebar { get; set; }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private bool IsActive(NavEntry entry)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');

        return entry.Exact
            ? path == entry.Href.TrimEnd('/') || (entry.Href == "/" && path == "/")
            : path == entry.Href || path.StartsWith(entry.Href + "/", StringComparison.Ordinal);
    }

    private RenderFragment RenderSection(NavSection section) =>
        @<ShadcnSidebarGroup Class="py-1">
            <ShadcnSidebarGroupLabel>@section.Label</ShadcnSidebarGroupLabel>
            <ShadcnSidebarGroupContent>
                <ShadcnSidebarMenu>
                    @foreach (var entry in section.Entries)
                    {
                        if (entry.AnyOf is null)
                        {
                            @RenderEntry(entry)
                        }
                        else
                        {
                            <PermissionView AnyOf="@entry.AnyOf">@RenderEntry(entry)</PermissionView>
                        }
                    }
                </ShadcnSidebarMenu>
            </ShadcnSidebarGroupContent>
        </ShadcnSidebarGroup>;

    private RenderFragment RenderEntry(NavEntry entry) =>
        @<ShadcnSidebarMenuItem>
            <ShadcnSidebarMenuButton Href="@entry.Href" IsActive="@IsActive(entry)">
                <Icon><i class="bi @entry.Icon text-base"></i></Icon>
                <TooltipContent>@entry.Label</TooltipContent>
                <ChildContent>@entry.Label</ChildContent>
            </ShadcnSidebarMenuButton>
        </ShadcnSidebarMenuItem>;
}
