@using Microsoft.AspNetCore.Components.Authorization

<nav class="w-64 bg-blue-800 text-white hidden md:flex flex-col p-4 shrink-0">
    <div class="text-xl font-bold mb-8 px-2">PeopleCore</div>

    <AuthorizeView Roles="Admin,HRManager">
        <Authorized>
            <div class="mb-4">
                <div class="text-xs uppercase text-blue-300 mb-2 px-2">Organization</div>
                <NavLink href="/departments" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-building text-sm shrink-0"></i>
                    Departments
                </NavLink>
                <NavLink href="/positions" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-briefcase text-sm shrink-0"></i>
                    Positions
                </NavLink>
            </div>
            <div class="mb-4">
                <div class="text-xs uppercase text-blue-300 mb-2 px-2">Employees</div>
                <NavLink href="/employees" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-people text-sm shrink-0"></i>
                    All Employees
                </NavLink>
            </div>
            <div class="mb-4">
                <div class="text-xs uppercase text-blue-300 mb-2 px-2">Recruitment</div>
                <NavLink href="/job-postings" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-file-text text-sm shrink-0"></i>
                    Job Postings
                </NavLink>
                <NavLink href="/applicants" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-person-plus text-sm shrink-0"></i>
                    Applicants
                </NavLink>
            </div>
            <div class="mb-4">
                <div class="text-xs uppercase text-blue-300 mb-2 px-2">Analytics</div>
                <NavLink href="/analytics" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900" Match="NavLinkMatch.All">
                    <i class="bi bi-graph-up text-sm shrink-0"></i>
                    Analytics
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="mb-4">
        <div class="text-xs uppercase text-blue-300 mb-2 px-2">My HR</div>
        <NavLink href="/" Match="NavLinkMatch.All" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
            <i class="bi bi-house text-sm shrink-0"></i>
            Dashboard
        </NavLink>
        <NavLink href="/my-profile" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
            <i class="bi bi-person-circle text-sm shrink-0"></i>
            My Profile
        </NavLink>
        <NavLink href="/my-attendance" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
            <i class="bi bi-clock text-sm shrink-0"></i>
            Attendance
        </NavLink>
        <NavLink href="/my-leave" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
            <i class="bi bi-calendar-check text-sm shrink-0"></i>
            Leave
        </NavLink>
    </div>

    <AuthorizeView Roles="Admin,HRManager,Manager">
        <Authorized>
            <div class="mb-4">
                <div class="text-xs uppercase text-blue-300 mb-2 px-2">Management</div>
                <NavLink href="/leave-approvals" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-check-square text-sm shrink-0"></i>
                    Leave Approvals
                </NavLink>
                <NavLink href="/overtime-approvals" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-clock-history text-sm shrink-0"></i>
                    OT Approvals
                </NavLink>
                <NavLink href="/performance" class="flex items-center gap-2 px-3 py-2 rounded hover:bg-blue-700 text-sm" ActiveClass="bg-blue-900">
                    <i class="bi bi-bar-chart text-sm shrink-0"></i>
                    Performance
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>
