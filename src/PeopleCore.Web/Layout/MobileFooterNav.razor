@using Microsoft.AspNetCore.Components.Authorization

@*
    The phone tab bar. `mobile-footer-nav` only carries the media query that shows it
    below the md breakpoint; everything visual comes from the shadcn tokens.
*@

<nav class="mobile-footer-nav fixed inset-x-0 bottom-0 z-40 items-stretch justify-around border-t border-border bg-background pb-[env(safe-area-inset-bottom)]">
    @foreach (var tab in Tabs)
    {
        <NavLink href="@tab.Href" Match="NavLinkMatch.All"
                 class="flex flex-1 flex-col items-center justify-center gap-0.5 py-2 text-[0.65rem] text-muted-foreground transition-colors hover:text-foreground"
                 ActiveClass="text-primary">
            <i class="bi @tab.Icon text-xl"></i>
            <span>@tab.Label</span>
        </NavLink>
    }
    @if (_visible.Count > 0)
    {
        <button type="button"
                class="flex flex-1 flex-col items-center justify-center gap-0.5 py-2 text-[0.65rem] transition-colors @(_showMore ? "text-primary" : "text-muted-foreground hover:text-foreground")"
                @onclick="ToggleMore">
            <i class="bi bi-three-dots text-xl"></i>
            <span>More</span>
        </button>
    }
</nav>

@if (_showMore)
{
    <div class="fixed inset-0 z-40 bg-black/50 md:hidden" @onclick="ToggleMore">
        <div class="absolute inset-x-0 bottom-16 max-h-[60vh] overflow-y-auto rounded-t-2xl border-t border-border bg-popover p-3 text-popover-foreground shadow-lg"
             @onclick:stopPropagation>
            <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-border"></div>
            @foreach (var group in _visible)
            {
                <p class="px-3 pb-1 pt-2 text-xs font-medium text-muted-foreground">@group.Label</p>
                @foreach (var link in group.Links)
                {
                    <NavLink href="@link.Href"
                             class="block rounded-md px-3 py-2.5 text-sm text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                             ActiveClass="bg-accent text-accent-foreground">
                        @link.Label
                    </NavLink>
                }
            }
        </div>
    </div>
}

@code {
    private sealed record Tab(string Href, string Label, string Icon);

    /// <summary>A link shown to anyone holding any of <paramref name="AnyOf"/>, or to everyone when it is empty.</summary>
    private sealed record MoreLink(string Href, string Label, string[] AnyOf);

    /// <summary>A group and the links of it this account may see; a group with none is not shown at all.</summary>
    private sealed record MoreGroup(string Label, MoreLink[] Links);

    private static readonly Tab[] Tabs =
    [
        new("", "Home", "bi-house-door"),
        new("my-attendance", "Attendance", "bi-clock"),
        new("my-leave", "Leave", "bi-calendar-event"),
        new("my-profile", "Profile", "bi-person")
    ];

    private static readonly MoreGroup[] MoreGroups =
    [
        new("My HR",
        [
            // The tab bar holds the other four; payslips would otherwise be out of reach on a phone.
            new("my-payslips", "Payslips", [])
        ]),
        new("Organization",
        [
            new("employees", "Employees", [Permissions.EmployeesViewAll]),
            new("departments", "Departments", [Permissions.OrganizationManage]),
            new("positions", "Positions", [Permissions.OrganizationManage]),
            new("analytics", "Analytics", [Permissions.AnalyticsHr])
        ]),
        new("Management",
        [
            new("leave-approvals", "Leave Approvals", [Permissions.ApprovalsTeam, Permissions.ApprovalsAll]),
            new("overtime-approvals", "OT Approvals", [Permissions.ApprovalsTeam, Permissions.ApprovalsAll]),
            new("performance", "Performance", [Permissions.ApprovalsTeam, Permissions.ApprovalsAll])
        ]),
        new("Payroll",
        [
            new("payroll-runs", "Payroll Runs", [Permissions.PayrollManage]),
            new("bir-2316", "BIR Form 2316", [Permissions.PayrollManage])
        ]),
        new("Recruitment",
        [
            new("job-postings", "Job Postings", [Permissions.RecruitmentManage]),
            new("applicants", "Applicants", [Permissions.RecruitmentManage])
        ]),
        new("Administration",
        [
            new("admin/users", "Users", [Permissions.UsersManage]),
            new("admin/roles", "Roles", [Permissions.RolesManage])
        ])
    ];

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _showMore;

    /// <summary>The groups and links this account may see. Empty groups are dropped, so the sheet is never blank.</summary>
    private List<MoreGroup> _visible = [];

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;

        _visible = MoreGroups
            .Select(group => group with
            {
                Links = group.Links.Where(link => link.AnyOf.Length == 0 || user?.HasAnyPermission(link.AnyOf) == true).ToArray()
            })
            .Where(group => group.Links.Length > 0)
            .ToList();
    }

    private void ToggleMore() => _showMore = !_showMore;
}
