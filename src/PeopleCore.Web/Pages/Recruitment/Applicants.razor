@page "/applicants"
@attribute [Authorize(Roles = "Admin,HRManager")]
@inject ApiClient Api

<div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-semibold">Applicants</h2>
    <select @bind="_statusFilter" @bind:after="Load"
            class="flex h-9 w-48 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:opacity-50">
        <option value="">All Status</option>
        <option value="Applied">Applied</option>
        <option value="Screening">Screening</option>
        <option value="Interviewing">Interviewing</option>
        <option value="Offered">Offered</option>
        <option value="Hired">Hired</option>
        <option value="Rejected">Rejected</option>
    </select>
</div>

<Card>
    <CardContent Class="p-0">
        @if (_applicants is null)
        {
            <div class="flex items-center justify-center p-10">
                <Spinner />
            </div>
        }
        else if (!_applicants.Items.Any())
        {
            <div class="p-6 text-sm text-muted-foreground">No applicants found.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Applicant</TableHead>
                        <TableHead Class="px-4">Job Posting</TableHead>
                        <TableHead Class="px-4">Applied</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var a in _applicants.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3">
                                <div class="font-medium">@a.FirstName @a.LastName</div>
                                <div class="text-xs text-muted-foreground">@a.Email</div>
                            </TableCell>
                            <TableCell Class="px-4 py-3">@a.JobPostingTitle</TableCell>
                            <TableCell Class="px-4 py-3">@a.AppliedAt.ToString("MMM d, yyyy")</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@ApplicantStatusVariant(a.Status)">@a.Status</Badge>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
    @if (_applicants is not null && _applicants.TotalPages > 1)
    {
        <CardFooter>
            <Pagination CurrentPage="@_page" TotalPages="@_applicants.TotalPages" OnPageChange="@HandlePage" />
        </CardFooter>
    }
</Card>

@code {
    private PagedResult<ApplicantDto>? _applicants;
    private string _statusFilter = string.Empty;
    private int _page = 1;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => _applicants = await Api.GetApplicantsAsync(status: string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter, page: _page);
    private async Task PrevPage() { if (_page > 1) { _page--; await Load(); } }
    private async Task NextPage() { if (_applicants is not null && _page < _applicants.TotalPages) { _page++; await Load(); } }

    private async Task HandlePage(int page) { _page = page; await Load(); }

    private static string ApplicantStatusVariant(string s) => s switch
    {
        "Hired" => "success",
        "Rejected" => "destructive",
        "Interviewing" => "default",
        _ => "secondary"
    };
}
