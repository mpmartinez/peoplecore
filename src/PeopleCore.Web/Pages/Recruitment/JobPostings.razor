@page "/job-postings"
@attribute [Authorize(Roles = "Admin,HRManager")]
@inject ApiClient Api

<div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-semibold">Job Postings</h2>
    <div class="flex items-center gap-3">
        <select @bind="_statusFilter" @bind:after="Load"
                class="flex h-9 w-40 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:opacity-50">
            <option value="">All Status</option>
            <option value="Draft">Draft</option>
            <option value="Open">Open</option>
            <option value="Closed">Closed</option>
        </select>
        <Button Variant="primary" OnClick="() => _showForm = !_showForm">+ New Posting</Button>
    </div>
</div>

@if (_showForm)
{
    <Card Class="mb-4">
        <CardHeader>
            <CardTitle>New Job Posting</CardTitle>
        </CardHeader>
        <CardContent>
            <div class="grid grid-cols-2 gap-3 mb-3">
                <FormField LabelText="Title *" Id="posting-title">
                    <Input Value="@_form.Title" ValueChanged="@(v => _form.Title = v)" Placeholder="Position title" />
                </FormField>
                <FormField LabelText="Vacancies" Id="posting-vacancies">
                    <Input Value="@_form.Vacancies.ToString()" ValueChanged="@(v => { if (int.TryParse(v, out var n)) _form.Vacancies = n; })" Type="number" />
                </FormField>
            </div>
            <div class="mb-3">
                <Label>Description</Label>
                <textarea @bind="_form.Description" rows="3"
                          class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
            </div>
            <div class="flex gap-2">
                <Button Variant="primary" Size="sm" OnClick="CreatePosting" Disabled="@(_saving || string.IsNullOrWhiteSpace(_form.Title))" Loading="@_saving">
                    Save Draft
                </Button>
                <Button Variant="outline" Size="sm" OnClick="() => _showForm = false">Cancel</Button>
            </div>
        </CardContent>
    </Card>
}

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mb-4">@_error</Alert>
}

<Card>
    <CardContent Class="p-0">
        @if (_postings is null)
        {
            <div class="flex items-center justify-center p-10">
                <Spinner />
            </div>
        }
        else if (!_postings.Items.Any())
        {
            <div class="p-6 text-sm text-muted-foreground">No job postings found.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Title</TableHead>
                        <TableHead Class="px-4">Department</TableHead>
                        <TableHead Class="px-4">Vacancies</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var p in _postings.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@p.Title</TableCell>
                            <TableCell Class="px-4 py-3">@(p.DepartmentName ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">@p.Vacancies</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@JobStatusVariant(p.Status)">@p.Status</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3">
                                <div class="flex gap-2">
                                    @if (p.Status == "Draft")
                                    {
                                        <Button Variant="ghost" Size="sm" OnClick="() => Publish(p.Id)">Publish</Button>
                                    }
                                    @if (p.Status == "Open")
                                    {
                                        <Button Variant="destructive" Size="sm" OnClick="() => Close(p.Id)">Close</Button>
                                    }
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@code {
    private PagedResult<JobPostingDto>? _postings;
    private string _statusFilter = string.Empty;
    private bool _showForm;
    private bool _saving;
    private string? _error;
    private JobPostingForm _form = new();

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => _postings = await Api.GetJobPostingsAsync(string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter);

    private async Task CreatePosting()
    {
        _saving = true; _error = null;
        try
        {
            await Api.CreateJobPostingAsync(new { title = _form.Title, description = _form.Description, vacancies = _form.Vacancies, departmentId = (Guid?)null, positionId = (Guid?)null, requirements = (string?)null });
            _showForm = false;
            _form = new();
            await Load();
        }
        catch { _error = "Failed to create posting."; }
        finally { _saving = false; }
    }

    private async Task Publish(Guid id) { try { await Api.PublishJobPostingAsync(id); await Load(); } catch { _error = "Failed to publish."; } }
    private async Task Close(Guid id) { try { await Api.CloseJobPostingAsync(id); await Load(); } catch { _error = "Failed to close."; } }

    private static string JobStatusVariant(string s) => s switch
    {
        "Open" => "success",
        "Closed" => "secondary",
        _ => "warning"
    };

    private class JobPostingForm { public string Title { get; set; } = string.Empty; public string? Description { get; set; } public int Vacancies { get; set; } = 1; }
}
