@page "/overtime-approvals"
@attribute [Authorize(Roles = "Admin,HRManager,Manager")]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Overtime Approvals</PageTitle>

<PageHeader Title="Overtime Approvals" Section="Management" Description="Overtime filings waiting on your decision.">
    <Actions>
        <div class="w-48">
            <Select TValue="string" Value="@_statusFilter"
                    ValueChanged="@(async v => { _statusFilter = v; await Load(); })">
                <option value="Pending">Pending</option>
                <option value="">All</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </Select>
        </div>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mt-4">@_error</Alert>
}

<Card>
    <CardContent Class="p-0">
        @if (_loadError is not null)
        {
            <div class="p-4"><Alert Variant="destructive" Title="Couldn't load overtime requests">@_loadError</Alert></div>
        }
        else if (_requests is null)
        {
            <div class="flex items-center justify-center p-10">
                <Spinner />
            </div>
        }
        else if (!_requests.Items.Any())
        {
            <div class="p-6 text-sm text-muted-foreground">No overtime requests.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Employee</TableHead>
                        <TableHead Class="px-4">Date</TableHead>
                        <TableHead Class="px-4">Hours</TableHead>
                        <TableHead Class="px-4">Reason</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _requests.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@r.EmployeeName</TableCell>
                            <TableCell Class="px-4 py-3">@r.OvertimeDate</TableCell>
                            <TableCell Class="px-4 py-3">@((r.TotalMinutes / 60.0).ToString("F1"))h</TableCell>
                            <TableCell Class="px-4 py-3 max-w-xs truncate">@r.Reason</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@OtStatusVariant(r.Status)">@r.Status</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3">
                                @if (r.Status == "Pending" && _currentEmployeeId.HasValue)
                                {
                                    <div class="flex gap-2">
                                        <Button Variant="ghost" Size="sm" OnClick="() => Approve(r.Id)">Approve</Button>
                                        <Button Variant="destructive" Size="sm" OnClick="() => Reject(r.Id)">Reject</Button>
                                    </div>
                                }
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@code {
    private PagedResult<OvertimeRequestDto>? _requests;
    private string _statusFilter = "Pending";
    private Guid? _currentEmployeeId;
    private string? _error;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var empId = auth.User.FindFirst("employee_id")?.Value;
        if (Guid.TryParse(empId, out var id)) _currentEmployeeId = id;
        await Load();
    }

    private async Task Load()
    {
        _loadError = null;
        try
        {
            _requests = await Api.GetOvertimeRequestsAsync(status: string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter);
        }
        catch (Exception ex)
        {
            // Not the previous list: after a filter change those rows belong to a different status.
            _requests = null;
            _loadError = ex.Message;
        }
    }

    private async Task Approve(Guid id)
    {
        if (!_currentEmployeeId.HasValue) { _error = "No employee ID linked to your account."; return; }
        try { await Api.ApproveOvertimeAsync(id); _error = null; await Load(); }
        catch (Exception ex) { _error = $"Failed to approve. {ex.Message}"; }
    }

    private async Task Reject(Guid id)
    {
        try { await Api.RejectOvertimeAsync(id, "Rejected by manager"); _error = null; await Load(); }
        catch (Exception ex) { _error = $"Failed to reject. {ex.Message}"; }
    }

    private static string OtStatusVariant(string s) => s switch
    {
        "Approved" => "success",
        "Rejected" => "destructive",
        _ => "warning"
    };
}
