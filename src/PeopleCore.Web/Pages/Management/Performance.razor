@page "/performance"
@attribute [Authorize(Roles = "Admin,HRManager,Manager")]
@inject ApiClient Api

<h2 class="text-2xl font-semibold mb-6">Performance</h2>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div>
        <Card>
            <CardHeader>
                <div class="flex items-center justify-between">
                    <CardTitle>Review Cycles</CardTitle>
                    <Button Variant="primary" Size="sm" OnClick="() => _showCycleForm = !_showCycleForm">+ New Cycle</Button>
                </div>
            </CardHeader>

            @if (_showCycleForm)
            {
                <CardContent>
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <FormField LabelText="Name *" Id="cycle-name">
                            <Input Value="@_cycleName" ValueChanged="@(v => _cycleName = v)" Placeholder="e.g. Q1 2026" />
                        </FormField>
                        <FormField LabelText="Year" Id="cycle-year">
                            <Input Value="@_cycleYear.ToString()" ValueChanged="@(v => { if (int.TryParse(v, out var yr)) _cycleYear = yr; })" Type="number" />
                        </FormField>
                        <div>
                            <Label>Start Date</Label>
                            <input type="date" @bind="_cycleStart"
                                   class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:opacity-50" />
                        </div>
                        <div>
                            <Label>End Date</Label>
                            <input type="date" @bind="_cycleEnd"
                                   class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:opacity-50" />
                        </div>
                    </div>
                    <div class="flex gap-2 mt-2">
                        <Button Variant="primary" Size="sm" OnClick="CreateCycle" Loading="@_savingCycle" Disabled="@_savingCycle">Save</Button>
                        <Button Variant="outline" Size="sm" OnClick="() => _showCycleForm = false">Cancel</Button>
                    </div>
                </CardContent>
            }

            <Separator />

            <CardContent Class="p-0">
                @if (_cycles is null)
                {
                    <div class="flex items-center justify-center p-8"><Spinner /></div>
                }
                else if (!_cycles.Items.Any())
                {
                    <div class="p-4 text-sm text-muted-foreground">No review cycles.</div>
                }
                else
                {
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead Class="px-4">Name</TableHead>
                                <TableHead Class="px-4">Year</TableHead>
                                <TableHead Class="px-4">Status</TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var c in _cycles.Items)
                            {
                                <TableRow Selected="@(_selectedCycleId == c.Id)" @onclick="() => SelectCycle(c.Id)">
                                    <TableCell Class="px-4 py-3 font-medium cursor-pointer">@c.Name</TableCell>
                                    <TableCell Class="px-4 py-3 cursor-pointer">@c.Year @(c.Quarter.HasValue ? $"Q{c.Quarter}" : "")</TableCell>
                                    <TableCell Class="px-4 py-3 cursor-pointer">
                                        <Badge Variant="@CycleStatusVariant(c.Status)">@c.Status</Badge>
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
            </CardContent>
        </Card>
    </div>

    <div>
        <Card>
            <CardHeader>
                <CardTitle>Performance Reviews @(_selectedCycleId.HasValue ? "(filtered by cycle)" : "")</CardTitle>
            </CardHeader>
            <CardContent Class="p-0">
                @if (_reviews is null)
                {
                    <div class="flex items-center justify-center p-8"><Spinner /></div>
                }
                else if (!_reviews.Items.Any())
                {
                    <div class="p-4 text-sm text-muted-foreground">No reviews found.</div>
                }
                else
                {
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead Class="px-4">Employee</TableHead>
                                <TableHead Class="px-4">Score</TableHead>
                                <TableHead Class="px-4">Status</TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var r in _reviews.Items)
                            {
                                <TableRow>
                                    <TableCell Class="px-4 py-3 font-medium">@r.EmployeeName</TableCell>
                                    <TableCell Class="px-4 py-3">@(r.FinalScore.HasValue ? r.FinalScore.Value.ToString("F1") : "--")</TableCell>
                                    <TableCell Class="px-4 py-3">
                                        <Badge Variant="@CycleStatusVariant(r.Status)">@r.Status</Badge>
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
            </CardContent>
        </Card>
    </div>
</div>

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mt-4">@_error</Alert>
}

@code {
    private PagedResult<ReviewCycleDto>? _cycles;
    private PagedResult<PerformanceReviewDto>? _reviews;
    private Guid? _selectedCycleId;
    private bool _showCycleForm;
    private bool _savingCycle;
    private string? _error;
    private string _cycleName = string.Empty;
    private int _cycleYear = DateTime.Today.Year;
    private DateOnly _cycleStart = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _cycleEnd = DateOnly.FromDateTime(DateTime.Today.AddMonths(3));

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCycles(), LoadReviews());
    }

    private async Task LoadCycles() => _cycles = await Api.GetReviewCyclesAsync();
    private async Task LoadReviews() => _reviews = await Api.GetPerformanceReviewsAsync(cycleId: _selectedCycleId);

    private async Task SelectCycle(Guid id)
    {
        _selectedCycleId = _selectedCycleId == id ? null : id;
        await LoadReviews();
    }

    private async Task CreateCycle()
    {
        _savingCycle = true; _error = null;
        try
        {
            await Api.CreateReviewCycleAsync(new { name = _cycleName, year = _cycleYear, quarter = (int?)null, startDate = _cycleStart.ToString("yyyy-MM-dd"), endDate = _cycleEnd.ToString("yyyy-MM-dd") });
            _showCycleForm = false;
            _cycleName = string.Empty;
            await LoadCycles();
        }
        catch { _error = "Failed to create cycle."; }
        finally { _savingCycle = false; }
    }

    private static string CycleStatusVariant(string s) => s switch
    {
        "Active" or "Open" => "success",
        "Completed" or "Closed" => "secondary",
        _ => "warning"
    };
}
