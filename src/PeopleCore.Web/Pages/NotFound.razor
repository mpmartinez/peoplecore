@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<PageTitle>Not Found</PageTitle>

<PageHeader Title="Page not found" Description="Sorry, the content you are looking for does not exist.">
    <Actions>
        <Button Variant="primary" OnClick="@(() => Nav.NavigateTo("/"))">
            <i class="bi bi-house mr-1"></i> Back to Dashboard
        </Button>
    </Actions>
</PageHeader>