@page "/"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard</PageTitle>

<PageHeader Title="Dashboard" Description="Welcome back! Here's your HR overview." />

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <Card Class="mb-6">
        <CardHeader>
            <CardTitle>Leave Balances</CardTitle>
        </CardHeader>
        <CardContent>
            @if (_notLinked)
            {
                <p class="text-sm text-muted-foreground">@NotLinkedText</p>
            }
            else if (_balancesError is not null)
            {
                <Alert Variant="destructive">@_balancesError</Alert>
            }
            else if (_balances is null)
            {
                <p class="text-sm text-muted-foreground">Loading...</p>
            }
            else if (!_balances.Any())
            {
                <p class="text-sm text-muted-foreground">No leave balances yet.</p>
            }
            else
            {
                <Table>
                    <TableBody>
                        @foreach (var b in _balances.Take(3))
                        {
                            <TableRow>
                                <TableCell>@b.LeaveTypeName</TableCell>
                                <TableCell Class="text-right">
                                    <Badge Variant="secondary">@b.RemainingDays days</Badge>
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>

    <Card Class="mb-6">
        <CardHeader>
            <CardTitle>Today's Attendance</CardTitle>
        </CardHeader>
        <CardContent>
            @if (_notLinked)
            {
                <p class="text-sm text-muted-foreground">@NotLinkedText</p>
            }
            else if (_attendanceError is not null)
            {
                <Alert Variant="destructive">@_attendanceError</Alert>
            }
            else if (!_attendanceLoaded)
            {
                <p class="text-sm text-muted-foreground">Loading...</p>
            }
            else if (_todayRecord is not null)
            {
                <div class="text-sm space-y-2">
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Time In</span>
                        <span class="font-medium">@(_todayRecord.TimeIn ?? "--:--")</span>
                    </div>
                    <Separator />
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Time Out</span>
                        <span class="font-medium">@(_todayRecord.TimeOut ?? "--:--")</span>
                    </div>
                    @if (_todayRecord.LateMinutes > 0)
                    {
                        <div class="pt-1">
                            <Badge Variant="destructive">Late by @_todayRecord.LateMinutes minutes</Badge>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-muted-foreground">Not clocked in yet today.</p>
            }
        </CardContent>
    </Card>

    <Card Class="mb-6">
        <CardHeader>
            <CardTitle>Pending Leave Requests</CardTitle>
        </CardHeader>
        <CardContent>
            @if (_notLinked && !_seesEveryone)
            {
                <p class="text-sm text-muted-foreground">@NotLinkedText</p>
            }
            else if (_pendingError is not null)
            {
                <Alert Variant="destructive">@_pendingError</Alert>
            }
            else if (_pendingCount is null)
            {
                <p class="text-sm text-muted-foreground">Loading...</p>
            }
            else
            {
                <div class="text-3xl font-bold text-foreground mb-1">@_pendingCount</div>
                <p class="text-sm text-muted-foreground">awaiting approval</p>
                @if (_pendingCount > 0)
                {
                    <div class="mt-3">
                        <Badge Variant="warning">Action Required</Badge>
                    </div>
                }
                else
                {
                    <div class="mt-3">
                        <Badge Variant="success">All Clear</Badge>
                    </div>
                }
            }
        </CardContent>
    </Card>

</div>

@code {
    private const string NotLinkedText = "Your account is not linked to an employee record.";

    // Each card loads and fails on its own, so one unavailable service does not blank the others.
    private bool _notLinked;
    private bool _seesEveryone;
    private IReadOnlyList<LeaveBalanceDto>? _balances;
    private string? _balancesError;
    private bool _attendanceLoaded;
    private AttendanceRecordDto? _todayRecord;
    private string? _attendanceError;
    private int? _pendingCount;
    private string? _pendingError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var empIdClaim = authState.User.FindFirst("employee_id")?.Value;
        Guid? employeeId = Guid.TryParse(empIdClaim, out var empId) ? empId : null;

        // An admin or HR login need not be an employee. There are no balances or attendance to
        // wait for then, and asking without an id would fail.
        _notLinked = employeeId is null;
        if (employeeId.HasValue)
        {
            await LoadBalances(employeeId.Value);
            await LoadTodaysAttendance(employeeId.Value);
        }

        // Without an id the count is the organisation's, which the API serves only to callers who
        // reach every employee. A Manager's unfiltered list is their direct reports', and an
        // account with no employee record has none, so anyone else with no employee record has
        // nothing to count.
        _seesEveryone = authState.User.HasAnyPermission(Permissions.EmployeesViewAll, Permissions.ApprovalsAll);
        if (employeeId.HasValue || _seesEveryone)
            await LoadPendingCount(employeeId);
    }

    private async Task LoadBalances(Guid employeeId)
    {
        try { _balances = await Api.GetLeaveBalancesAsync(employeeId) ?? []; }
        catch (Exception ex) { _balancesError = ex.Message; }
    }

    private async Task LoadTodaysAttendance(Guid employeeId)
    {
        try
        {
            var attendance = await Api.GetAttendanceAsync(employeeId, page: 1, pageSize: 1);
            _todayRecord = attendance?.Items.FirstOrDefault(r =>
                r.AttendanceDate == DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd"));
            _attendanceLoaded = true;
        }
        catch (Exception ex) { _attendanceError = ex.Message; }
    }

    private async Task LoadPendingCount(Guid? employeeId)
    {
        // Only the total is needed, so ask for a single row and read the count the API reports.
        try
        {
            var pending = await Api.GetLeaveRequestsAsync(employeeId: employeeId, page: 1, pageSize: 1, status: "Pending");
            _pendingCount = pending?.TotalCount ?? 0;
        }
        catch (Exception ex) { _pendingError = ex.Message; }
    }
}
