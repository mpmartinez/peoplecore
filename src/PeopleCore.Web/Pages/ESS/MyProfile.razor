@page "/my-profile"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Profile</PageTitle>

<PageHeader Title="My Profile" Section="My HR" Description="Your employment record as HR holds it, and your sign-in password." />

<div class="grid gap-6 lg:grid-cols-2 items-start max-w-5xl">
    <section aria-label="Employment record">
        @if (_loadError is not null)
        {
            <Alert Variant="destructive" Title="Couldn't load your profile">@_loadError</Alert>
        }
        else if (_employee is null)
        {
            <Card>
                <CardContent Class="p-6 text-center text-muted-foreground text-sm">
                    @(_loading ? "Loading..." : "Profile not linked to an employee record.")
                </CardContent>
            </Card>
        }
        else
        {
            <Card>
                <CardHeader>
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xl font-bold">
                            @(_employee.FirstName.FirstOrDefault())@(_employee.LastName.FirstOrDefault())
                        </div>
                        <div>
                            <CardTitle>@_employee.FullName</CardTitle>
                            <CardDescription>@_employee.WorkEmail</CardDescription>
                        </div>
                    </div>
                </CardHeader>
                <CardContent>
                    <Separator Class="mb-4" />
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between py-1.5 border-b border-border">
                            <span class="text-muted-foreground">Employee #</span>
                            <span class="font-mono font-medium">@_employee.EmployeeNumber</span>
                        </div>
                        <div class="flex justify-between py-1.5 border-b border-border">
                            <span class="text-muted-foreground">Department</span>
                            <span>@(_employee.DepartmentName ?? "--")</span>
                        </div>
                        <div class="flex justify-between py-1.5 border-b border-border">
                            <span class="text-muted-foreground">Position</span>
                            <span>@(_employee.PositionTitle ?? "--")</span>
                        </div>
                        <div class="flex justify-between py-1.5 border-b border-border">
                            <span class="text-muted-foreground">Employment Status</span>
                            <span>@_employee.EmploymentStatus</span>
                        </div>
                        <div class="flex justify-between py-1.5">
                            <span class="text-muted-foreground">Account Status</span>
                            <Badge Variant="@(_employee.IsActive ? "success" : "secondary")">
                                @(_employee.IsActive ? "Active" : "Inactive")
                            </Badge>
                        </div>
                    </div>
                </CardContent>
            </Card>
        }
    </section>

    @* Outside the employee-record branches on purpose: an account with no employee record behind
       it (the seeded admin, say) still has a password to change. *@
    <section aria-label="Change password">
        <Card>
            <CardHeader>
                <CardTitle>Change Password</CardTitle>
                <CardDescription>You'll use the new password the next time you sign in.</CardDescription>
            </CardHeader>
            <CardContent>
                <form id="change-password" class="space-y-4" @onsubmit="ChangePassword" @onsubmit:preventDefault>
                    @if (_passwordError is not null)
                    {
                        <Alert Variant="destructive" data-password-result>@_passwordError</Alert>
                    }
                    else if (_passwordChanged)
                    {
                        <Alert Variant="success" data-password-result>Your password has been changed.</Alert>
                    }

                    <FormField LabelText="Current password" Id="current-password" Error="@_currentError">
                        <PasswordInput Id="current-password" @bind-Value="_currentPassword"
                                       AutoComplete="current-password" HasError="@(_currentError is not null)"
                                       Disabled="@_saving" />
                    </FormField>
                    <FormField LabelText="New password" Id="new-password" Error="@_newError"
                               Description="@($"At least {MinimumLength} characters, including a number.")">
                        <PasswordInput Id="new-password" @bind-Value="_newPassword"
                                       AutoComplete="new-password" HasError="@(_newError is not null)"
                                       Disabled="@_saving" />
                    </FormField>
                    <FormField LabelText="Confirm new password" Id="confirm-password" Error="@_confirmError">
                        <PasswordInput Id="confirm-password" @bind-Value="_confirmPassword"
                                       AutoComplete="new-password" HasError="@(_confirmError is not null)"
                                       Disabled="@_saving" />
                    </FormField>
                    <Button Type="submit" Variant="primary" Loading="@_saving">Change Password</Button>
                </form>
            </CardContent>
        </Card>
    </section>
</div>

@code {
    // Mirrors the API's Identity password policy (ServiceExtensions.AddIdentity) so the common
    // mistakes are caught before a round trip. The API stays the authority: anything it rejects
    // for another reason comes back in the error message.
    private const int MinimumLength = 8;

    private EmployeeListDto? _employee;
    private bool _loading = true;
    private string? _loadError;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _currentError;
    private string? _newError;
    private string? _confirmError;
    private string? _passwordError;
    private bool _passwordChanged;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var empIdStr = auth.User.FindFirst("employee_id")?.Value;
        try
        {
            if (Guid.TryParse(empIdStr, out var empId))
                _employee = await Api.GetEmployeeAsync(empId);
        }
        catch (Exception ex)
        {
            // Includes a 404 for a claim that points at an employee record since deleted.
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangePassword()
    {
        _passwordError = null;
        _passwordChanged = false;

        _currentError = string.IsNullOrEmpty(_currentPassword) ? "Enter your current password." : null;
        _newError = _newPassword switch
        {
            "" => "Enter a new password.",
            { Length: < MinimumLength } => $"Use at least {MinimumLength} characters.",
            _ when !_newPassword.Any(char.IsDigit) => "Include at least one number.",
            _ when _newPassword == _currentPassword => "Choose a password different from your current one.",
            _ => null
        };
        _confirmError = _newError is null && _confirmPassword != _newPassword ? "The passwords don't match." : null;

        if (_currentError is not null || _newError is not null || _confirmError is not null) return;

        _saving = true;
        try
        {
            await Api.ChangePasswordAsync(_currentPassword, _newPassword);
            _passwordChanged = true;
            _currentPassword = _newPassword = _confirmPassword = string.Empty;
        }
        catch (Exception ex)
        {
            _passwordError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
