@page "/my-attendance"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Attendance</PageTitle>

<PageHeader Title="My Attendance" Section="My HR" Description="Clock in and out, and review your attendance history." />

<Card Class="mb-6">
    <CardContent Class="pt-4">
        @if (_employeeId == Guid.Empty)
        {
            <Alert Variant="warning" Title="Account not linked">
                Your account is not linked to an employee record. Time In / Time Out is unavailable.
            </Alert>
        }
        else
        {
            <div class="flex flex-wrap items-center gap-3">
                @* Full-width, large targets on a phone; ordinary buttons once there is room. *@
                <Button Variant="primary" Size="lg" Class="w-full sm:w-auto" OnClick="TimeIn" Disabled="@(_clockedIn || _processing)" Loading="@(_processing && !_clockedIn)">
                    <i class="bi bi-clock-history mr-1"></i> Time In
                </Button>
                <Button Variant="destructive" Size="lg" Class="w-full sm:w-auto" OnClick="TimeOut" Disabled="@(!_clockedIn || _clockedOut || _processing)" Loading="@(_processing && _clockedIn)">
                    <i class="bi bi-clock mr-1"></i> Time Out
                </Button>
                <Separator Orientation="vertical" Class="hidden h-6 sm:block" />
                <span class="text-sm text-muted-foreground">@DateTime.Now.ToString("hh:mm tt, MMMM dd yyyy")</span>
                @if (_message is not null)
                {
                    <Badge Variant="@(_isError ? "destructive" : "success")">@_message</Badge>
                }
                else if (_clockedOut)
                {
                    <span class="text-sm text-muted-foreground">You have clocked out for today.</span>
                }
            </div>
        }
    </CardContent>
</Card>

<Card>
    <CardHeader Class="flex flex-row items-center justify-between gap-2 space-y-0">
        <CardTitle>Recent Attendance</CardTitle>
        @if (_employeeId != Guid.Empty)
        {
            <Button Variant="outline" Size="sm" data-request-new OnClick="@(() => StartRequest(null))">
                <i class="bi bi-pencil-square mr-1"></i> Request a correction
            </Button>
        }
    </CardHeader>
    <CardContent Class="p-0">
        @if (_employeeId == Guid.Empty)
        {
            <div class="p-6 text-center text-muted-foreground text-sm">No attendance to show for an account without an employee record.</div>
        }
        else if (_loadError is not null)
        {
            <div class="p-4"><Alert Variant="destructive" Title="Couldn't load your attendance">@_loadError</Alert></div>
        }
        else if (_records is null)
        {
            <div class="p-6 flex justify-center"><Spinner /></div>
        }
        else if (!_records.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">No attendance records found.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Date</TableHead>
                        <TableHead Class="px-4">Time In</TableHead>
                        <TableHead Class="px-4">Time Out</TableHead>
                        <TableHead Class="px-4 text-right">Late (min)</TableHead>
                        <TableHead Class="px-4 text-right">Undertime (min)</TableHead>
                        <TableHead Class="px-4"></TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _records.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3">@r.AttendanceDate</TableCell>
                            <TableCell Class="px-4 py-3">@(WallClock.Time(r.TimeIn) ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">@(WallClock.Time(r.TimeOut) ?? "--")</TableCell>
                            <TableCell Class="@("px-4 py-3 text-right " + (r.LateMinutes > 0 ? "text-destructive font-medium" : ""))">@r.LateMinutes</TableCell>
                            <TableCell Class="@("px-4 py-3 text-right " + (r.UndertimeMinutes > 0 ? "text-warning font-medium" : ""))">@r.UndertimeMinutes</TableCell>
                            <TableCell Class="px-4 py-3 text-right">
                                <Button Variant="ghost" Size="sm" data-request="@r.AttendanceDate" OnClick="@(() => StartRequest(r))">Fix</Button>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@if (_employeeId != Guid.Empty && _requests is { Items.Count: > 0 })
{
    <Card Class="mt-6" data-my-corrections>
        <CardHeader><CardTitle>My Correction Requests</CardTitle></CardHeader>
        <CardContent Class="p-0">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Date</TableHead>
                        <TableHead Class="px-4">Asked for</TableHead>
                        <TableHead Class="px-4">Reason</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var c in _requests.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3">@c.AttendanceDate.ToString("MMM d, yyyy")</TableCell>
                            <TableCell Class="px-4 py-3">@(WallClock.Time(c.NewTimeIn) ?? "--") – @(WallClock.Time(c.NewTimeOut) ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3 max-w-xs">
                                @c.Reason
                                @if (c.RejectionReason is not null)
                                {
                                    <div class="text-xs text-destructive">Rejected: @c.RejectionReason</div>
                                }
                            </TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@RequestVariant(c.Status)">@(c.Status == "Pending" ? "Waiting for approval" : c.Status)</Badge>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </CardContent>
    </Card>
}

<AttendanceCorrectionDialog IsOpen="@_requesting" Title="Request a correction"
                            Description="Your manager or HR approves it before your attendance changes."
                            DateEditable="true" Date="@_requestDate" TimeIn="@_requestIn" TimeOut="@_requestOut"
                            SubmitLabel="Send request" ReasonPlaceholder="For example: forgot to scan out, or the clock was down"
                            Busy="@_sending" Error="@_requestError"
                            OnSubmit="SendRequest" OnClose="@(() => _requesting = _sending)" />

@code {
    private PagedResult<AttendanceCorrectionDto>? _requests;
    private bool _requesting;
    private bool _sending;
    private string? _requestError;
    private DateOnly _requestDate;
    private string? _requestIn;
    private string? _requestOut;

    private static string RequestVariant(string status) => status switch
    {
        "Applied" => "success",
        "Rejected" => "destructive",
        _ => "warning",
    };

    private async Task LoadRequests()
    {
        if (_employeeId == Guid.Empty) return;
        try
        {
            _requests = await Api.GetAttendanceCorrectionsAsync(_employeeId, pageSize: 10);
        }
        catch
        {
            // The list of past requests is secondary: attendance and filing a request still work without it.
            _requests = null;
        }
    }

    /// <summary>Opens the request form on a recorded day, or on today for a day with no record.</summary>
    private void StartRequest(AttendanceRecordDto? record)
    {
        _requestError = null;
        _requestDate = record is null
            ? DateOnly.FromDateTime(DateTime.Today)
            : DateOnly.Parse(record.AttendanceDate, System.Globalization.CultureInfo.InvariantCulture);
        _requestIn = WallClock.Time(record?.TimeIn);
        _requestOut = WallClock.Time(record?.TimeOut);
        _requesting = true;
    }

    private async Task SendRequest(AttendanceCorrectionRequest request)
    {
        _sending = true;
        _requestError = null;
        try
        {
            await Api.RequestAttendanceCorrectionAsync(request);
            _requesting = false;
            _message = $"Correction for {request.Date:MMM d} sent for approval.";
            _isError = false;
            await LoadRequests();
        }
        catch (Exception ex)
        {
            _requestError = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }
}

@code {
    private PagedResult<AttendanceRecordDto>? _records;
    private bool _clockedIn;
    private bool _clockedOut;
    private bool _processing;
    private string? _loadError;
    private string? _message;
    private bool _isError;
    private Guid _employeeId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var empIdClaim = authState.User.FindFirst("employee_id")?.Value;
        if (Guid.TryParse(empIdClaim, out var empId))
            _employeeId = empId;

        await LoadRecords();
        await LoadRequests();
        var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
        var todays = _records?.Items.FirstOrDefault(r => r.AttendanceDate == today);
        _clockedIn = todays?.TimeIn != null;
        // The API takes one time-in a day and lets a later time-out overwrite an earlier one, so once
        // today's record has both, neither button has anything legitimate left to do.
        _clockedOut = todays?.TimeOut != null;
    }

    private async Task LoadRecords()
    {
        if (_employeeId == Guid.Empty) return;
        _loadError = null;
        try
        {
            _records = await Api.GetAttendanceAsync(_employeeId, page: 1, pageSize: 20);
        }
        catch (Exception ex)
        {
            // Only the history is lost; clocking in and out do not depend on it.
            _records = null;
            _loadError = ex.Message;
        }
    }

    private async Task TimeIn()
    {
        _processing = true;
        try
        {
            await Api.TimeInAsync(_employeeId);
            _clockedIn = true;
            _message = "Clocked in successfully.";
            _isError = false;
            await LoadRecords();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _processing = false; }
    }

    private async Task TimeOut()
    {
        _processing = true;
        try
        {
            await Api.TimeOutAsync(_employeeId);
            _clockedOut = true;
            _message = "Clocked out successfully.";
            _isError = false;
            await LoadRecords();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _processing = false; }
    }
}
