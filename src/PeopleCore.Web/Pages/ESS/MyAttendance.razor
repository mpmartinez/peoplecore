@page "/my-attendance"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<h2 class="text-2xl font-semibold text-foreground mb-6">My Attendance</h2>

<Card Class="mb-6">
    <CardContent Class="pt-4">
        @if (_employeeId == Guid.Empty)
        {
            <Alert Variant="warning" Title="Account not linked">
                Your account is not linked to an employee record. Time In / Time Out is unavailable.
            </Alert>
        }
        else
        {
            <div class="flex gap-3 items-center flex-wrap">
                <Button Variant="primary" Class="btn-time-action" OnClick="TimeIn" Disabled="@(_clockedIn || _processing)" Loading="@(_processing && !_clockedIn)">
                    <i class="bi bi-clock-history mr-1"></i> Time In
                </Button>
                <Button Variant="destructive" Class="btn-time-action" OnClick="TimeOut" Disabled="@(!_clockedIn || _processing)" Loading="@(_processing && _clockedIn)">
                    <i class="bi bi-clock mr-1"></i> Time Out
                </Button>
                <Separator Orientation="vertical" Class="h-6" />
                <span class="text-sm text-muted-foreground">@DateTime.Now.ToString("hh:mm tt, MMMM dd yyyy")</span>
                @if (_message is not null)
                {
                    <Badge Variant="@(_isError ? "destructive" : "success")">@_message</Badge>
                }
            </div>
        }
    </CardContent>
</Card>

<Card>
    <CardHeader>
        <CardTitle>Recent Attendance</CardTitle>
    </CardHeader>
    <CardContent Class="p-0">
        @if (_records is null)
        {
            <div class="p-6 flex justify-center"><Spinner /></div>
        }
        else if (!_records.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">No attendance records found.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Date</TableHead>
                        <TableHead Class="px-4">Time In</TableHead>
                        <TableHead Class="px-4">Time Out</TableHead>
                        <TableHead Class="px-4 text-right">Late (min)</TableHead>
                        <TableHead Class="px-4 text-right">Undertime (min)</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _records.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3">@r.AttendanceDate</TableCell>
                            <TableCell Class="px-4 py-3">@(r.TimeIn ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">@(r.TimeOut ?? "--")</TableCell>
                            <TableCell Class="@("px-4 py-3 text-right " + (r.LateMinutes > 0 ? "text-destructive font-medium" : ""))">@r.LateMinutes</TableCell>
                            <TableCell Class="@("px-4 py-3 text-right " + (r.UndertimeMinutes > 0 ? "text-orange-600 font-medium" : ""))">@r.UndertimeMinutes</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@code {
    private PagedResult<AttendanceRecordDto>? _records;
    private bool _clockedIn;
    private bool _processing;
    private string? _message;
    private bool _isError;
    private Guid _employeeId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var empIdClaim = authState.User.FindFirst("employee_id")?.Value;
        if (Guid.TryParse(empIdClaim, out var empId))
            _employeeId = empId;

        await LoadRecords();
        var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
        _clockedIn = _records?.Items.Any(r => r.AttendanceDate == today && r.TimeIn != null) ?? false;
    }

    private async Task LoadRecords()
    {
        if (_employeeId == Guid.Empty) return;
        _records = await Api.GetAttendanceAsync(_employeeId, page: 1, pageSize: 20);
    }

    private async Task TimeIn()
    {
        _processing = true;
        try
        {
            await Api.TimeInAsync(_employeeId);
            _clockedIn = true;
            _message = "Clocked in successfully.";
            _isError = false;
            await LoadRecords();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _processing = false; }
    }

    private async Task TimeOut()
    {
        _processing = true;
        try
        {
            await Api.TimeOutAsync(_employeeId);
            _message = "Clocked out successfully.";
            _isError = false;
            await LoadRecords();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _processing = false; }
    }
}
