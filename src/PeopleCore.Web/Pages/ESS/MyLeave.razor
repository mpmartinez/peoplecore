@page "/my-leave"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<h2 class="text-2xl font-semibold text-foreground mb-6">My Leave</h2>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <Card>
        <CardHeader>
            <CardTitle>Leave Balances (@DateTime.UtcNow.Year)</CardTitle>
        </CardHeader>
        <CardContent Class="p-0">
            @if (_balances is null)
            {
                <div class="p-6 flex justify-center"><Spinner /></div>
            }
            else if (!_balances.Any())
            {
                <div class="p-6 text-center text-muted-foreground text-sm">No leave balances found.</div>
            }
            else
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead Class="px-4">Type</TableHead>
                            <TableHead Class="px-4 text-right">Total</TableHead>
                            <TableHead Class="px-4 text-right">Used</TableHead>
                            <TableHead Class="px-4 text-right">Remaining</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var b in _balances)
                        {
                            <TableRow>
                                <TableCell Class="px-4 py-3">@b.LeaveTypeName</TableCell>
                                <TableCell Class="px-4 py-3 text-right">@b.TotalDays</TableCell>
                                <TableCell Class="px-4 py-3 text-right">@b.UsedDays</TableCell>
                                <TableCell Class="px-4 py-3 text-right font-semibold text-primary">@b.RemainingDays</TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>

    <Card>
        <CardHeader>
            <CardTitle>File Leave Request</CardTitle>
        </CardHeader>
        <CardContent>
            @if (_successMsg is not null)
            {
                <Alert Variant="success" Class="mb-3">@_successMsg</Alert>
            }
            @if (_error is not null)
            {
                <Alert Variant="destructive" Class="mb-3">@_error</Alert>
            }
            <div class="space-y-3">
                <div>
                    <label class="text-sm font-medium block mb-1">Leave Type</label>
                    <select @bind="_leaveTypeId" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring">
                        <option value="">-- Select leave type --</option>
                        @if (_balances is not null)
                        {
                            @foreach (var b in _balances)
                            {
                                <option value="@b.LeaveTypeId">@b.LeaveTypeName (@b.RemainingDays days left)</option>
                            }
                        }
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-sm font-medium block mb-1">From</label>
                        <input type="date" @bind="_startDate" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                    </div>
                    <div>
                        <label class="text-sm font-medium block mb-1">To</label>
                        <input type="date" @bind="_endDate" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                    </div>
                </div>
                <div>
                    <label class="text-sm font-medium block mb-1">Reason (optional)</label>
                    <textarea @bind="_reason" rows="2" class="flex min-h-[60px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
                </div>
                <Button Variant="primary" Class="w-full" OnClick="SubmitLeave" Loading="@_submitting">Submit Request</Button>
            </div>
        </CardContent>
    </Card>
</div>

<Card>
    <CardHeader>
        <CardTitle>Leave History</CardTitle>
    </CardHeader>
    <CardContent Class="p-0">
        @if (_requests is null)
        {
            <div class="p-6 flex justify-center"><Spinner /></div>
        }
        else if (!_requests.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">No leave requests yet.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Type</TableHead>
                        <TableHead Class="px-4">From</TableHead>
                        <TableHead Class="px-4">To</TableHead>
                        <TableHead Class="px-4 text-right">Days</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _requests.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3">@r.LeaveTypeName</TableCell>
                            <TableCell Class="px-4 py-3">@r.StartDate</TableCell>
                            <TableCell Class="px-4 py-3">@r.EndDate</TableCell>
                            <TableCell Class="px-4 py-3 text-right">@r.TotalDays</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@LeaveStatusVariant(r.Status)">@r.Status</Badge>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@code {
    private IReadOnlyList<LeaveBalanceDto>? _balances;
    private PagedResult<LeaveRequestDto>? _requests;
    private Guid _employeeId;
    private string _leaveTypeId = string.Empty;
    private DateTime _startDate = DateTime.Today;
    private DateTime _endDate = DateTime.Today;
    private string? _reason;
    private string? _successMsg;
    private string? _error;
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var empIdClaim = authState.User.FindFirst("employee_id")?.Value;
        if (Guid.TryParse(empIdClaim, out var empId))
            _employeeId = empId;

        await Task.WhenAll(LoadBalances(), LoadRequests());
    }

    private async Task LoadBalances()
        => _balances = await Api.GetLeaveBalancesAsync(_employeeId);

    private async Task LoadRequests()
        => _requests = await Api.GetLeaveRequestsAsync(_employeeId, page: 1, pageSize: 20);

    private async Task SubmitLeave()
    {
        _submitting = true;
        _error = null;
        _successMsg = null;
        try
        {
            if (string.IsNullOrEmpty(_leaveTypeId))
            { _error = "Please select a leave type."; return; }

            await Api.CreateLeaveRequestAsync(new
            {
                employeeId = _employeeId,
                leaveTypeId = Guid.Parse(_leaveTypeId),
                startDate = DateOnly.FromDateTime(_startDate),
                endDate = DateOnly.FromDateTime(_endDate),
                reason = _reason
            });
            _successMsg = "Leave request submitted successfully.";
            await Task.WhenAll(LoadBalances(), LoadRequests());
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _submitting = false; }
    }

    private static string LeaveStatusVariant(string s) => s switch
    {
        "Approved" => "success",
        "Rejected" => "destructive",
        "Cancelled" => "secondary",
        _ => "warning"
    };
}
