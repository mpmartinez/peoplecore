@page "/leave-approvals"
@attribute [Authorize(Roles = "Admin,HRManager,Manager")]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Leave Approvals</PageTitle>

<PageHeader Title="Leave Approvals" Section="Management" Description="Leave requests waiting on your decision.">
    <Actions>
        <Select TValue="string" Value="@_statusFilter" Class="w-[160px]"
                ValueChanged="@(async v => { _statusFilter = v; await LoadRequests(); })">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
        </Select>
    </Actions>
</PageHeader>

<Card>
    <CardContent Class="p-0">
        @if (_requests is null)
        {
            <div class="p-6 flex justify-center"><Spinner /></div>
        }
        else if (!_requests.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">No pending leave requests.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Employee</TableHead>
                        <TableHead Class="px-4">Type</TableHead>
                        <TableHead Class="px-4">From</TableHead>
                        <TableHead Class="px-4">To</TableHead>
                        <TableHead Class="px-4">Days</TableHead>
                        <TableHead Class="px-4">Reason</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _requests.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@r.EmployeeName</TableCell>
                            <TableCell Class="px-4 py-3">@r.LeaveTypeName</TableCell>
                            <TableCell Class="px-4 py-3">@r.StartDate</TableCell>
                            <TableCell Class="px-4 py-3">@r.EndDate</TableCell>
                            <TableCell Class="px-4 py-3">@r.TotalDays</TableCell>
                            <TableCell Class="px-4 py-3 text-muted-foreground max-w-xs truncate">@(r.Reason ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@LeaveStatusVariant(r.Status)">@r.Status</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3">
                                @if (r.Status == "Pending")
                                {
                                    <div class="flex gap-2">
                                        <Button Variant="ghost" Size="sm" OnClick="() => Approve(r.Id)">Approve</Button>
                                        <Button Variant="destructive" Size="sm" OnClick="() => Reject(r.Id)">Reject</Button>
                                    </div>
                                }
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mt-4">@_error</Alert>
}

@code {
    private PagedResult<LeaveRequestDto>? _requests;
    private string? _message;
    private string? _error;
    private string _statusFilter = "";

    protected override async Task OnInitializedAsync() => await LoadRequests();

    private async Task LoadRequests()
        => _requests = await Api.GetLeaveRequestsAsync(page: 1, pageSize: 50);

    private async Task Approve(Guid requestId)
    {
        try
        {
            await Api.ApproveLeaveAsync(requestId);
            _message = "Leave request approved.";
            _error = null;
            await LoadRequests();
        }
        catch (Exception ex) { _message = ex.Message; _error = ex.Message; }
    }

    private async Task Reject(Guid requestId)
    {
        try
        {
            await Api.RejectLeaveAsync(requestId, "Rejected by manager.");
            _message = "Leave request rejected.";
            _error = null;
            await LoadRequests();
        }
        catch (Exception ex) { _message = ex.Message; _error = ex.Message; }
    }

    private static string LeaveStatusVariant(string s) => s switch
    {
        "Approved" => "success",
        "Rejected" => "destructive",
        _ => "warning"
    };
}
