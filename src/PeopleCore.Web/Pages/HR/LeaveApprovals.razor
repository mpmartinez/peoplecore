@page "/leave-approvals"
@attribute [Authorize(Roles = "Admin,HRManager,Manager")]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Leave Approvals</PageTitle>

<PageHeader Title="Leave Approvals" Section="Management" Description="Leave requests waiting on your decision.">
    <Actions>
        <div class="w-[160px]">
            <Select TValue="string" Value="@_statusFilter"
                    ValueChanged="@(async v => { _statusFilter = v; _page = 1; await LoadRequests(); })">
                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </Select>
        </div>
    </Actions>
</PageHeader>

<Card>
    <CardContent Class="p-0">
        @if (_loadError is not null)
        {
            <div class="p-4"><Alert Variant="destructive">@_loadError</Alert></div>
        }
        else if (_requests is null)
        {
            <div class="p-6 flex justify-center"><Spinner /></div>
        }
        else if (!_requests.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">@EmptyText</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Employee</TableHead>
                        <TableHead Class="px-4">Type</TableHead>
                        <TableHead Class="px-4">From</TableHead>
                        <TableHead Class="px-4">To</TableHead>
                        <TableHead Class="px-4">Days</TableHead>
                        <TableHead Class="px-4">Reason</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _requests.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@r.EmployeeName</TableCell>
                            <TableCell Class="px-4 py-3">@r.LeaveTypeName</TableCell>
                            <TableCell Class="px-4 py-3">@r.StartDate</TableCell>
                            <TableCell Class="px-4 py-3">@r.EndDate</TableCell>
                            <TableCell Class="px-4 py-3">@r.TotalDays</TableCell>
                            <TableCell Class="px-4 py-3 text-muted-foreground max-w-xs truncate">@(r.Reason ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@LeaveStatusVariant(r.Status)">@r.Status</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3">
                                @if (r.Status == "Pending" && CanDecide(r))
                                {
                                    <div class="flex gap-2">
                                        <Button Variant="ghost" Size="sm" OnClick="() => Approve(r.Id)">Approve</Button>
                                        <Button Variant="destructive" Size="sm" OnClick="() => Reject(r.Id)">Reject</Button>
                                    </div>
                                }
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>

            @if (_requests.TotalPages > 1)
            {
                <div class="border-t px-4 py-3">
                    <Pagination CurrentPage="@_page" TotalPages="@_requests.TotalPages" OnPageChange="@HandlePageChange" />
                </div>
            }
        }
    </CardContent>
</Card>

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mt-4">@_error</Alert>
}

@code {
    private PagedResult<LeaveRequestDto>? _requests;
    private string? _loadError;
    private string? _error;
    private string _statusFilter = "";
    private int _page = 1;
    private const int _pageSize = 50;

    // The signed-in account's employee. The API decides as it, refuses an account without one, and
    // refuses anyone approving or rejecting their own leave, so decisions are offered only where
    // they can succeed.
    private Guid? _currentEmployeeId;

    private bool CanDecide(LeaveRequestDto request)
        => _currentEmployeeId is { } me && request.EmployeeId != me;

    private string EmptyText => _statusFilter == ""
        ? "No leave requests."
        : $"No {_statusFilter.ToLowerInvariant()} leave requests.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(auth.User.FindFirst("employee_id")?.Value, out var id)) _currentEmployeeId = id;
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        try
        {
            _requests = await Api.GetLeaveRequestsAsync(page: _page, pageSize: _pageSize, status: _statusFilter);
            _loadError = null;
        }
        catch (Exception ex)
        {
            _requests = null;
            _loadError = ex.Message;
            return;
        }

        // Deciding the last request on the last page of a filtered list can leave that page empty
        // while earlier pages still have requests.
        if (_requests is { Items.Count: 0, TotalPages: > 0 } && _page > _requests.TotalPages)
        {
            _page = _requests.TotalPages;
            await LoadRequests();
        }
    }

    private async Task HandlePageChange(int page)
    {
        _page = page;
        await LoadRequests();
    }

    private async Task Approve(Guid requestId)
    {
        try { await Api.ApproveLeaveAsync(requestId); }
        catch (Exception ex) { _error = ex.Message; return; }

        // Decided, so any earlier failure no longer applies. A failed reload is the list's error.
        _error = null;
        await LoadRequests();
    }

    private async Task Reject(Guid requestId)
    {
        try { await Api.RejectLeaveAsync(requestId, "Rejected by manager."); }
        catch (Exception ex) { _error = ex.Message; return; }

        _error = null;
        await LoadRequests();
    }

    private static string LeaveStatusVariant(string s) => s switch
    {
        "Approved" => "success",
        "Rejected" => "destructive",
        _ => "warning"
    };
}
