@page "/leave-approvals"
@attribute [RequirePermission(Permissions.ApprovalsTeam, Permissions.ApprovalsAll)]
@inject ApiClient Api
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Leave Approvals</PageTitle>

<PageHeader Title="Leave Approvals" Section="Management" Description="Leave requests waiting on your decision.">
    <Actions>
        <div class="w-[160px]">
            <Select TValue="string" Value="@_statusFilter"
                    ValueChanged="@(async v => { _statusFilter = v; _page = 1; await LoadRequests(); })">
                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </Select>
        </div>
    </Actions>
</PageHeader>

<Card>
    <CardContent Class="p-0">
        @if (_loadError is not null)
        {
            <div class="p-4"><Alert Variant="destructive">@_loadError</Alert></div>
        }
        else if (_requests is null)
        {
            <div class="p-6 flex justify-center"><Spinner /></div>
        }
        else if (!_requests.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">@EmptyText</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Employee</TableHead>
                        <TableHead Class="px-4">Type</TableHead>
                        <TableHead Class="px-4">From</TableHead>
                        <TableHead Class="px-4">To</TableHead>
                        <TableHead Class="px-4">Days</TableHead>
                        <TableHead Class="px-4">Reason</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _requests.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@r.EmployeeName</TableCell>
                            <TableCell Class="px-4 py-3">
                                <div>@r.LeaveTypeName</div>
                                @if (!r.IsMasked && r.MaternityCase is { } maternityCase)
                                {
                                    <div class="text-xs text-muted-foreground" data-maternity>@MaternityText(maternityCase, r.DaysAllocatedToFather)</div>
                                }
                                @if (!r.IsMasked && r.HasDocument)
                                {
                                    var request = r;
                                    <button type="button" class="mt-1 text-xs font-medium text-primary underline-offset-4 hover:underline disabled:opacity-50"
                                            disabled="@(_openingDocument == request.Id)"
                                            @onclick="() => ViewDocument(request.Id)" data-view-document="@request.Id">View document</button>
                                }
                                else if (NeedsDocument(r))
                                {
                                    <div class="mt-1"><Badge Variant="warning" data-no-document>No document attached</Badge></div>
                                }
                            </TableCell>
                            <TableCell Class="px-4 py-3">@r.StartDate</TableCell>
                            <TableCell Class="px-4 py-3">@r.EndDate</TableCell>
                            <TableCell Class="px-4 py-3">@r.TotalDays</TableCell>
                            <TableCell Class="px-4 py-3 text-muted-foreground max-w-xs truncate">@(r.Reason ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@LeaveStatusVariant(r.Status)">@r.Status</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3">
                                @if (r.Status == "Pending" && CanDecide(r))
                                {
                                    <div class="flex gap-2">
                                        <Button Variant="ghost" Size="sm" OnClick="() => Approve(r.Id)">Approve</Button>
                                        <Button Variant="destructive" Size="sm" OnClick="() => Reject(r.Id)">Reject</Button>
                                    </div>
                                }
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>

            @if (_requests.TotalPages > 1)
            {
                <div class="border-t px-4 py-3">
                    <Pagination CurrentPage="@_page" TotalPages="@_requests.TotalPages" OnPageChange="@HandlePageChange" />
                </div>
            }
        }
    </CardContent>
</Card>

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mt-4">@_error</Alert>
}
@if (_documentLink is not null)
{
    <p class="mt-4 text-sm text-muted-foreground" data-document-fallback>
        If the document didn't open,
        <a href="@_documentLink" target="_blank" rel="noopener noreferrer" class="font-medium text-primary underline" data-document-link>open it here</a>.
        The link works for 5 minutes.
    </p>
}

@code {
    private PagedResult<LeaveRequestDto>? _requests;
    private string? _loadError;
    private string? _error;
    private string _statusFilter = "";
    private int _page = 1;
    private const int _pageSize = 50;

    // The signed-in account's employee. The API decides as it, refuses an account without one, and
    // refuses anyone approving or rejecting their own leave, so decisions are offered only where
    // they can succeed.
    private Guid? _currentEmployeeId;

    // A confidential request reaches anyone without approvals.all masked, and the API refuses them a
    // decision on it. The queue leaves such requests out; this keeps the buttons off if one gets through.
    private bool CanDecide(LeaveRequestDto request)
        => _currentEmployeeId is { } me && request.EmployeeId != me && !request.IsMasked;

    // Which types need a supporting document before approval. Only the warnings need it, so a
    // failure to load leaves them off rather than the queue.
    private HashSet<Guid> _typesNeedingDocument = [];
    private Guid? _openingDocument;
    // The last document link, offered in case the browser didn't open it.
    private string? _documentLink;

    private bool NeedsDocument(LeaveRequestDto request)
        => !request.IsMasked && !request.HasDocument && _typesNeedingDocument.Contains(request.LeaveTypeId);

    private static string MaternityText(MaternityCase maternityCase, int fatherDays) => maternityCase switch
    {
        MaternityCase.LiveBirth when fatherDays > 0 => $"Live birth, {fatherDays} {(fatherDays == 1 ? "day" : "days")} to the father",
        MaternityCase.LiveBirth => "Live birth",
        _ => "Miscarriage or emergency termination",
    };

    private string EmptyText => _statusFilter == ""
        ? "No leave requests."
        : $"No {_statusFilter.ToLowerInvariant()} leave requests.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(auth.User.FindFirst("employee_id")?.Value, out var id)) _currentEmployeeId = id;
        await Task.WhenAll(LoadRequests(), LoadLeaveTypes());
    }

    private async Task LoadLeaveTypes()
    {
        try
        {
            var types = await Api.GetLeaveTypesAsync() ?? [];
            _typesNeedingDocument = types.Where(t => t.RequiresDocument).Select(t => t.Id).ToHashSet();
        }
        catch
        {
            _typesNeedingDocument = [];
        }
    }

    // The link expires after 300 seconds, so it is fetched on each click and opened straight away,
    // with noopener,noreferrer: the document's tab gets no handle on this page, nor its address.
    private async Task ViewDocument(Guid requestId)
    {
        if (_openingDocument is not null) return;

        _openingDocument = requestId;
        _documentLink = null;
        try
        {
            var url = await Api.GetLeaveDocumentUrlAsync(requestId);
            if (url is null)
            {
                _error = "The document's link didn't come back. Try again.";
                return;
            }

            _error = null;
            if (!await OpenInNewTab(url)) _documentLink = url;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _openingDocument = null;
        }
    }

    // window.open answers null when it opened nothing (a popup blocker). With noopener, browsers
    // following the HTML spec answer null even when the tab did open, so the fallback link is
    // worded to make sense either way. A window that does come back can't be serialised, which
    // surfaces as a JSException: that too means something opened.
    private async Task<bool> OpenInNewTab(string url)
    {
        try
        {
            return await JS.InvokeAsync<object?>("open", url, "_blank", "noopener,noreferrer") is not null;
        }
        catch (JSException)
        {
            return true;
        }
    }

    private async Task LoadRequests()
    {
        try
        {
            _requests = await Api.GetLeaveRequestsAsync(page: _page, pageSize: _pageSize, status: _statusFilter);
            _loadError = null;
        }
        catch (Exception ex)
        {
            _requests = null;
            _loadError = ex.Message;
            return;
        }

        // Deciding the last request on the last page of a filtered list can leave that page empty
        // while earlier pages still have requests.
        if (_requests is { Items.Count: 0, TotalPages: > 0 } && _page > _requests.TotalPages)
        {
            _page = _requests.TotalPages;
            await LoadRequests();
        }
    }

    private async Task HandlePageChange(int page)
    {
        _page = page;
        await LoadRequests();
    }

    private async Task Approve(Guid requestId)
    {
        try { await Api.ApproveLeaveAsync(requestId); }
        catch (Exception ex) { _error = ex.Message; return; }

        // Decided, so any earlier failure no longer applies. A failed reload is the list's error.
        _error = null;
        await LoadRequests();
    }

    private async Task Reject(Guid requestId)
    {
        try { await Api.RejectLeaveAsync(requestId, "Rejected by manager."); }
        catch (Exception ex) { _error = ex.Message; return; }

        _error = null;
        await LoadRequests();
    }

    private static string LeaveStatusVariant(string s) => s switch
    {
        "Approved" => "success",
        "Rejected" => "destructive",
        _ => "warning"
    };
}
