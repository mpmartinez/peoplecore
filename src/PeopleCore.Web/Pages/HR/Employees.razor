@page "/employees"
@attribute [Authorize(Roles = "Admin,HRManager")]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Employees</PageTitle>

<PageHeader Title="Employees" Section="Organization" Description="Everyone on the payroll, active and inactive.">
    <Actions>
        <Button Variant="primary" OnClick="OpenAddForm">
            <i class="bi bi-plus-lg mr-1"></i> Add Employee
        </Button>
    </Actions>
</PageHeader>

<Card Class="mb-4">
    <CardContent Class="pt-4">
        <div class="flex gap-3 flex-wrap">
            <Input TValue="string" Value="@_search"
                   ValueChanged="@(async v => { _search = v; await OnSearch(); })"
                   Placeholder="Search by name or number..."
                   Type="text"
                   Class="flex-1 max-w-xs" />
            <Select TValue="string" Value="@_statusFilter" Class="max-w-[160px]"
                    ValueChanged="@(async v => { _statusFilter = v; await LoadEmployees(); })">
                <option value="">All Status</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </Select>
        </div>
    </CardContent>
</Card>

<Card>
    <CardContent Class="p-0">
        @if (_employees is null)
        {
            <div class="p-6 flex justify-center"><Spinner /></div>
        }
        else if (!_employees.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">No employees found.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Employee #</TableHead>
                        <TableHead Class="px-4">Name</TableHead>
                        <TableHead Class="px-4">Department</TableHead>
                        <TableHead Class="px-4">Position</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4">Employment</TableHead>
                        <TableHead Class="px-4">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var emp in _employees.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-mono text-xs">@emp.EmployeeNumber</TableCell>
                            <TableCell Class="px-4 py-3">
                                <div class="font-medium">@emp.FullName</div>
                                <div class="text-xs text-muted-foreground">@emp.WorkEmail</div>
                            </TableCell>
                            <TableCell Class="px-4 py-3 text-muted-foreground">@(emp.DepartmentName ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3 text-muted-foreground">@(emp.PositionTitle ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@(emp.IsActive ? "success" : "secondary")">@(emp.IsActive ? "Active" : "Inactive")</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3 text-muted-foreground">@emp.EmploymentStatus</TableCell>
                            <TableCell Class="px-4 py-3">
                                <AuthorizeView Roles="Admin,HRManager,PayrollService">
                                    <Button Variant="ghost" Size="sm" OnClick="() => GoToCompensation(emp.Id)">Compensation</Button>
                                </AuthorizeView>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>

            @if (_employees.TotalPages > 1)
            {
                <div class="border-t px-4 py-3">
                    <Pagination CurrentPage="@_page" TotalPages="@_employees.TotalPages" OnPageChange="@HandlePageChange" />
                </div>
            }
        }
    </CardContent>
</Card>

<Sheet IsOpen="@_showForm"
       IsOpenChanged="@(v => _showForm = v)"
       Title="Add Employee"
       Description="Fill in the employee details below."
       Side="right">
    <ChildContent>
        @if (_formError is not null)
        {
            <Alert Variant="destructive" Class="mb-4">@_formError</Alert>
        }

        <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2">
                <FormField LabelText="Employee Number *" Id="empNumber" Class="mb-4">
                    <Input TValue="string" Value="@_form.EmployeeNumber"
                           ValueChanged="@(v => _form.EmployeeNumber = v)"
                           Placeholder="e.g. EMP-001"
                           Type="text" />
                </FormField>
            </div>
            <div>
                <FormField LabelText="First Name *" Id="firstName" Class="mb-4">
                    <Input TValue="string" Value="@_form.FirstName"
                           ValueChanged="@(v => _form.FirstName = v)"
                           Type="text" />
                </FormField>
            </div>
            <div>
                <FormField LabelText="Middle Name" Id="middleName" Class="mb-4">
                    <Input TValue="string" Value="@_form.MiddleName"
                           ValueChanged="@(v => _form.MiddleName = v)"
                           Type="text" />
                </FormField>
            </div>
            <div class="col-span-2">
                <FormField LabelText="Last Name *" Id="lastName" Class="mb-4">
                    <Input TValue="string" Value="@_form.LastName"
                           ValueChanged="@(v => _form.LastName = v)"
                           Type="text" />
                </FormField>
            </div>
            <div>
                <FormField LabelText="Date of Birth" Id="dob" Required="true" Class="mb-4">
                    <Input TValue="DateOnly" Id="dob" Type="date" @bind-Value="_form.DateOfBirth" />
                </FormField>
            </div>
            <div>
                <FormField LabelText="Gender" Id="gender" Required="true" Class="mb-4">
                    <Select TValue="string" Id="gender" @bind-Value="_form.Gender" Placeholder="Select...">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </Select>
                </FormField>
            </div>
            <div class="col-span-2">
                <FormField LabelText="Work Email *" Id="workEmail" Class="mb-4">
                    <Input TValue="string" Value="@_form.WorkEmail"
                           ValueChanged="@(v => _form.WorkEmail = v)"
                           Type="email" />
                </FormField>
            </div>
            <div class="col-span-2">
                <FormField LabelText="Mobile Number" Id="mobileNumber" Class="mb-4">
                    <Input TValue="string" Value="@_form.MobileNumber"
                           ValueChanged="@(v => _form.MobileNumber = v)"
                           Placeholder="+63..."
                           Type="text" />
                </FormField>
            </div>
            <div>
                <FormField LabelText="Department" Id="department" Class="mb-4">
                    <Select TValue="Guid?" Id="department" Value="@_form.DepartmentId" Placeholder="None"
                            ValueChanged="@(async v => { _form.DepartmentId = v; await OnDepartmentChanged(); })">
                        @foreach (var dept in _departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </Select>
                </FormField>
            </div>
            <div>
                <FormField LabelText="Position" Id="position" Class="mb-4">
                    <Select TValue="Guid?" Id="position" @bind-Value="_form.PositionId" Placeholder="None">
                        @foreach (var pos in _positions)
                        {
                            <option value="@pos.Id">@pos.Title</option>
                        }
                    </Select>
                </FormField>
            </div>
            <div>
                <FormField LabelText="Employment Status" Id="empStatus" Required="true" Class="mb-4">
                    <Select TValue="string" Id="empStatus" @bind-Value="_form.EmploymentStatus" Placeholder="Select...">
                        <option value="Probationary">Probationary</option>
                        <option value="Regular">Regular</option>
                        <option value="Contractual">Contractual</option>
                    </Select>
                </FormField>
            </div>
            <div>
                <FormField LabelText="Employment Type" Id="empType" Required="true" Class="mb-4">
                    <Select TValue="string" Id="empType" @bind-Value="_form.EmploymentType" Placeholder="Select...">
                        <option value="Regular">Regular</option>
                        <option value="Probationary">Probationary</option>
                        <option value="Contractual">Contractual</option>
                        <option value="PartTime">Part-Time</option>
                        <option value="Casual">Casual</option>
                    </Select>
                </FormField>
            </div>
            <div class="col-span-2">
                <FormField LabelText="Hire Date" Id="hireDate" Required="true" Class="mb-4">
                    <Input TValue="DateOnly" Id="hireDate" Type="date" @bind-Value="_form.HireDate" />
                </FormField>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <Button Variant="outline" Size="sm" OnClick="CloseForm">Cancel</Button>
        <Button Variant="primary" Size="sm" OnClick="SubmitForm" Loading="@_saving">Save Employee</Button>
    </FooterContent>
</Sheet>

@code {
    private PagedResult<EmployeeListDto>? _employees;
    private List<DepartmentDto> _departments = [];
    private List<PositionDto> _positions = [];
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private int _page = 1;
    private const int _pageSize = 20;
    private bool _showForm;
    private bool _saving;
    private string? _formError;
    private EmployeeFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadEmployees(), LoadDepartments());
    }

    private async Task LoadDepartments()
    {
        var result = await Api.GetDepartmentsAsync(pageSize: 100);
        _departments = result?.Items.ToList() ?? [];
    }

    private async Task LoadEmployees()
    {
        _employees = await Api.GetEmployeesAsync(_page, _pageSize);
    }

    private async Task OnSearch()
    {
        _page = 1;
        await LoadEmployees();
    }

    private async Task PrevPage() { if (_page > 1) { _page--; await LoadEmployees(); } }
    private async Task NextPage() { if (_employees is not null && _page < _employees.TotalPages) { _page++; await LoadEmployees(); } }

    private async Task HandlePageChange(int page)
    {
        _page = page;
        await LoadEmployees();
    }

    private void OpenAddForm()
    {
        _form = new EmployeeFormModel();
        _positions = [];
        _formError = null;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private void GoToCompensation(Guid employeeId) => Nav.NavigateTo($"/employees/{employeeId}/compensation");

    private async Task OnDepartmentChanged()
    {
        _form.PositionId = null;
        _positions = [];
        if (_form.DepartmentId.HasValue)
        {
            var result = await Api.GetPositionsAsync(_form.DepartmentId, pageSize: 100);
            _positions = result?.Items.ToList() ?? [];
        }
    }

    private async Task SubmitForm()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_form.EmployeeNumber) ||
            string.IsNullOrWhiteSpace(_form.FirstName) ||
            string.IsNullOrWhiteSpace(_form.LastName) ||
            string.IsNullOrWhiteSpace(_form.WorkEmail) ||
            string.IsNullOrWhiteSpace(_form.Gender) ||
            string.IsNullOrWhiteSpace(_form.EmploymentStatus) ||
            string.IsNullOrWhiteSpace(_form.EmploymentType))
        {
            _formError = "Please fill in all required fields.";
            return;
        }

        _saving = true;
        try
        {
            await Api.CreateEmployeeAsync(new
            {
                employeeNumber = _form.EmployeeNumber,
                firstName = _form.FirstName,
                middleName = _form.MiddleName,
                lastName = _form.LastName,
                dateOfBirth = _form.DateOfBirth.ToString("yyyy-MM-dd"),
                gender = _form.Gender,
                workEmail = _form.WorkEmail,
                mobileNumber = _form.MobileNumber,
                departmentId = _form.DepartmentId,
                positionId = _form.PositionId,
                employmentStatus = _form.EmploymentStatus,
                employmentType = _form.EmploymentType,
                hireDate = _form.HireDate.ToString("yyyy-MM-dd")
            });
            CloseForm();
            _page = 1;
            await LoadEmployees();
        }
        catch
        {
            _formError = "Failed to save employee. Check all fields and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private class EmployeeFormModel
    {
        public string EmployeeNumber { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string? MiddleName { get; set; }
        public string LastName { get; set; } = "";
        public DateOnly DateOfBirth { get; set; } = new DateOnly(1990, 1, 1);
        public string Gender { get; set; } = "";
        public string WorkEmail { get; set; } = "";
        public string? MobileNumber { get; set; }
        public Guid? DepartmentId { get; set; }
        public Guid? PositionId { get; set; }
        public string EmploymentStatus { get; set; } = "";
        public string EmploymentType { get; set; } = "";
        public DateOnly HireDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }
}
