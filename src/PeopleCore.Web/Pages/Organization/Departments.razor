@page "/departments"
@attribute [RequirePermission(Permissions.OrganizationManage)]
@inject ApiClient Api

<PageTitle>Departments</PageTitle>

<PageHeader Title="Departments" Section="Organization" Description="The organizational units employees and positions belong to." />

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mb-4">@_error</Alert>
}
@if (_companiesError is not null)
{
    <Alert Variant="destructive" Class="mb-4">Companies could not be loaded, so departments cannot be added: @_companiesError</Alert>
}
else if (_companies is { Count: 0 })
{
    <Alert Variant="warning" Class="mb-4">Departments belong to a company, and no company has been set up yet.</Alert>
}

<Card Class="mb-4">
    <CardContent>
        <div class="flex items-end gap-3 flex-wrap">
            <div class="flex-1 min-w-[160px]">
                <Label>Name</Label>
                <Input TValue="string" Value="@_newName" ValueChanged="@(v => _newName = v)" Placeholder="Department name" />
            </div>
            <div class="flex-1 min-w-[120px]">
                <Label>Code</Label>
                <Input TValue="string" Value="@(_newCode ?? "")" ValueChanged="@(v => _newCode = string.IsNullOrEmpty(v) ? null : v)" Placeholder="e.g. HR, FIN" />
            </div>
            <Button Variant="primary" OnClick="Create" Disabled="@(_creating || string.IsNullOrWhiteSpace(_newName) || _companies is not { Count: > 0 })" Loading="@_creating">
                + Add
            </Button>
        </div>
    </CardContent>
</Card>

<Card>
    <CardContent Class="p-0">
        @if (_loadError is not null)
        {
            <div class="p-4"><Alert Variant="destructive">@_loadError</Alert></div>
        }
        else if (_departments is null)
        {
            <div class="flex items-center justify-center p-10">
                <Spinner />
            </div>
        }
        else if (!_departments.Items.Any())
        {
            <div class="p-6 text-sm text-muted-foreground">No departments yet.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Name</TableHead>
                        <TableHead Class="px-4">Code</TableHead>
                        <TableHead Class="px-4">Parent</TableHead>
                        <TableHead Class="px-4">Sub-depts</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var d in _departments.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@d.Name</TableCell>
                            <TableCell Class="px-4 py-3 font-mono text-xs">@(d.Code ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">@(d.ParentDepartmentName ?? "--")</TableCell>
                            <TableCell Class="px-4 py-3">@d.SubDepartmentCount</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>

            @if (_departments.TotalPages > 1)
            {
                <div class="border-t px-4 py-3">
                    <Pagination CurrentPage="@_page" TotalPages="@_departments.TotalPages" OnPageChange="@HandlePageChange" />
                </div>
            }
        }
    </CardContent>
</Card>

@code {
    private PagedResult<DepartmentDto>? _departments;
    private string? _loadError;
    private int _page = 1;
    private IReadOnlyList<CompanyDto>? _companies;
    private string? _companiesError;
    private string _newName = string.Empty;
    private string? _newCode;
    private bool _creating;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Companies only matter to Add, so their failure is explained there and the list still loads.
        try
        {
            _companies = await Api.GetCompaniesAsync();
        }
        catch (Exception ex)
        {
            _companiesError = ex.Message;
        }
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _departments = await Api.GetDepartmentsAsync(page: _page);
            _loadError = null;
        }
        catch (Exception ex)
        {
            _departments = null;
            _loadError = ex.Message;
        }
    }

    private async Task HandlePageChange(int page)
    {
        _page = page;
        await Load();
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_newName) || _companies is not { Count: > 0 }) return;
        _creating = true;
        _error = null;
        try
        {
            await Api.CreateDepartmentAsync(new { companyId = _companies[0].Id, name = _newName, code = _newCode, parentDepartmentId = (Guid?)null });
        }
        catch (Exception ex)
        {
            _error = $"Failed to create department. {ex.Message}";
            return;
        }
        finally { _creating = false; }

        // Created. If the reload fails, that is the list's error to show, not a failed create.
        _newName = string.Empty;
        _newCode = null;
        await Load();
    }
}
