@page "/positions"
@attribute [RequirePermission(Permissions.OrganizationManage)]
@inject ApiClient Api

<PageTitle>Positions</PageTitle>

<PageHeader Title="Positions" Section="Organization" Description="Job titles available within each department." />

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mb-4">@_error</Alert>
}
@if (_departmentsError is not null)
{
    <Alert Variant="destructive" Class="mb-4">Departments could not be loaded, so positions cannot be added: @_departmentsError</Alert>
}

<Card Class="mb-4">
    <CardContent>
        <div class="flex items-end gap-3 flex-wrap">
            <div class="min-w-[180px]">
                <Label For="newDept">Department</Label>
                <Select TValue="string" Id="newDept" @bind-Value="_newDeptId" Placeholder="-- Select --" Class="mt-1">
                    @foreach (var d in _allDepts)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </Select>
            </div>
            <div class="flex-1 min-w-[160px]">
                <Label>Title</Label>
                <Input TValue="string" Value="@_newTitle" ValueChanged="@(v => _newTitle = v)" Placeholder="Position title" />
            </div>
            <div class="flex-1 min-w-[140px]">
                <Label>Level</Label>
                <Input TValue="string" Value="@(_newLevel ?? "")" ValueChanged="@(v => _newLevel = string.IsNullOrEmpty(v) ? null : v)" Placeholder="e.g. Junior, Senior" />
            </div>
            <Button Variant="primary" OnClick="Create" Disabled="@(_creating || string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newDeptId))" Loading="@_creating">
                + Add
            </Button>
        </div>
    </CardContent>
</Card>

<Card>
    <CardContent Class="p-0">
        @if (_loadError is not null)
        {
            <div class="p-4"><Alert Variant="destructive">@_loadError</Alert></div>
        }
        else if (_positions is null)
        {
            <div class="flex items-center justify-center p-10">
                <Spinner />
            </div>
        }
        else if (!_positions.Items.Any())
        {
            <div class="p-6 text-sm text-muted-foreground">No positions yet.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Title</TableHead>
                        <TableHead Class="px-4">Department</TableHead>
                        <TableHead Class="px-4">Level</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var p in _positions.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@p.Title</TableCell>
                            <TableCell Class="px-4 py-3">@p.DepartmentName</TableCell>
                            <TableCell Class="px-4 py-3">@(p.Level ?? "--")</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>

            @if (_positions.TotalPages > 1)
            {
                <div class="border-t px-4 py-3">
                    <Pagination CurrentPage="@_page" TotalPages="@_positions.TotalPages" OnPageChange="@HandlePageChange" />
                </div>
            }
        }
    </CardContent>
</Card>

@code {
    private PagedResult<PositionDto>? _positions;
    private string? _loadError;
    private int _page = 1;
    private List<DepartmentDto> _allDepts = [];
    private string? _departmentsError;
    private string _newTitle = string.Empty;
    private string? _newLevel;
    private string _newDeptId = string.Empty;
    private bool _creating;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
        await Load();
    }

    private async Task LoadDepartments()
    {
        // Every page, not just the first: a department left out of the picker is one nobody can
        // add a position to. A failure only affects Add, so the list still loads.
        try
        {
            var all = new List<DepartmentDto>();
            for (var page = 1; ; page++)
            {
                var result = await Api.GetDepartmentsAsync(page, pageSize: 100);
                if (result is null) break;
                all.AddRange(result.Items);
                if (page >= result.TotalPages) break;
            }
            _allDepts = all;
        }
        catch (Exception ex)
        {
            _departmentsError = ex.Message;
        }
    }

    private async Task Load()
    {
        try
        {
            _positions = await Api.GetPositionsAsync(page: _page, pageSize: 100);
            _loadError = null;
        }
        catch (Exception ex)
        {
            _positions = null;
            _loadError = ex.Message;
        }
    }

    private async Task HandlePageChange(int page)
    {
        _page = page;
        await Load();
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newDeptId)) return;
        _creating = true;
        _error = null;
        try
        {
            await Api.CreatePositionAsync(new { departmentId = Guid.Parse(_newDeptId), title = _newTitle, level = _newLevel });
        }
        catch (Exception ex)
        {
            _error = $"Failed to create position. {ex.Message}";
            return;
        }
        finally { _creating = false; }

        // Created. If the reload fails, that is the list's error to show, not a failed create.
        _newTitle = string.Empty;
        _newLevel = null;
        _newDeptId = string.Empty;
        await Load();
    }
}
