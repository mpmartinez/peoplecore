@page "/positions"
@attribute [Authorize(Roles = "Admin,HRManager")]
@inject ApiClient Api

<PageTitle>Positions</PageTitle>

<PageHeader Title="Positions" Section="Organization" Description="Job titles available within each department." />

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mb-4">@_error</Alert>
}

<Card Class="mb-4">
    <CardContent>
        <div class="flex items-end gap-3 flex-wrap">
            <div class="min-w-[180px]">
                <Label For="newDept">Department</Label>
                <Select TValue="string" Id="newDept" @bind-Value="_newDeptId" Placeholder="-- Select --" Class="mt-1">
                    @foreach (var d in _allDepts?.Items ?? [])
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </Select>
            </div>
            <div class="flex-1 min-w-[160px]">
                <Label>Title</Label>
                <Input TValue="string" Value="@_newTitle" ValueChanged="@(v => _newTitle = v)" Placeholder="Position title" />
            </div>
            <div class="flex-1 min-w-[140px]">
                <Label>Level</Label>
                <Input TValue="string" Value="@(_newLevel ?? "")" ValueChanged="@(v => _newLevel = string.IsNullOrEmpty(v) ? null : v)" Placeholder="e.g. Junior, Senior" />
            </div>
            <Button Variant="primary" OnClick="Create" Disabled="@(_creating || string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newDeptId))" Loading="@_creating">
                + Add
            </Button>
        </div>
    </CardContent>
</Card>

<Card>
    <CardContent Class="p-0">
        @if (_positions is null)
        {
            <div class="flex items-center justify-center p-10">
                <Spinner />
            </div>
        }
        else if (!_positions.Items.Any())
        {
            <div class="p-6 text-sm text-muted-foreground">No positions yet.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Title</TableHead>
                        <TableHead Class="px-4">Department</TableHead>
                        <TableHead Class="px-4">Level</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var p in _positions.Items)
                    {
                        <TableRow>
                            <TableCell Class="px-4 py-3 font-medium">@p.Title</TableCell>
                            <TableCell Class="px-4 py-3">@p.DepartmentName</TableCell>
                            <TableCell Class="px-4 py-3">@(p.Level ?? "--")</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
</Card>

@code {
    private PagedResult<PositionDto>? _positions;
    private PagedResult<DepartmentDto>? _allDepts;
    private string _newTitle = string.Empty;
    private string? _newLevel;
    private string _newDeptId = string.Empty;
    private bool _creating;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _allDepts = await Api.GetDepartmentsAsync(pageSize: 100);
        await Load();
    }

    private async Task Load() => _positions = await Api.GetPositionsAsync(pageSize: 100);

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newDeptId)) return;
        _creating = true;
        _error = null;
        try
        {
            await Api.CreatePositionAsync(new { departmentId = Guid.Parse(_newDeptId), title = _newTitle, level = _newLevel });
            _newTitle = string.Empty;
            _newLevel = null;
            _newDeptId = string.Empty;
            await Load();
        }
        catch { _error = "Failed to create position."; }
        finally { _creating = false; }
    }
}
