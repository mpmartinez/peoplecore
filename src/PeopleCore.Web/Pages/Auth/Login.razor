@page "/login"
@layout PeopleCore.Web.Components.Layout.EmptyLayout
@inject PeopleCore.Web.Services.ApiClient Api
@inject PeopleCore.Web.Auth.JwtAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="min-h-screen flex items-center justify-center bg-muted/30">
    <Card Class="w-full max-w-sm">
        <CardHeader>
            <CardTitle Class="text-2xl text-center">PeopleCore</CardTitle>
            <p class="text-sm text-muted-foreground text-center mt-1">Sign in to your account</p>
        </CardHeader>
        <CardContent>
            @if (_resetDone)
            {
                <Alert Variant="success" Class="mb-4" data-reset-done>
                    Your password has been changed. Sign in with your new password.
                </Alert>
            }
            @if (_error != null)
            {
                <Alert Variant="destructive" Class="mb-4">@_error</Alert>
            }

            <div class="space-y-4">
                <FormField LabelText="Email" Id="email">
                    <Input TValue="string" Id="email" Type="email" @bind-Value="_email"
                           AutoComplete="username" Placeholder="you@company.com" />
                </FormField>
                <FormField LabelText="Password" Id="password" Class="mb-6">
                    <PasswordInput Id="password" @bind-Value="_password"
                                   AutoComplete="current-password"
                                   OnKeyDown="@(async e => { if (e.Key == "Enter") await HandleLogin(); })" />
                </FormField>
                @if (_resetAvailable)
                {
                    <p class="text-sm text-right -mt-2">
                        <a class="text-primary hover:underline" href="/forgot-password">Forgot password?</a>
                    </p>
                }
                <Button Variant="primary" Class="w-full" OnClick="HandleLogin" Loading="@_loading">
                    Sign In
                </Button>
            </div>
        </CardContent>
    </Card>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _resetAvailable;
    private bool _resetDone;

    protected override async Task OnInitializedAsync()
    {
        // Parsed rather than Contains("reset=1"), so ?reset=10 does not also match.
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _resetDone = query.TryGetValue("reset", out var reset) && reset == "1";

        // No link at all is better than one that leads to a page which cannot send anything.
        _resetAvailable = await Api.IsPasswordResetAvailableAsync();
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Please enter your email and password.";
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            var result = await Api.LoginAsync(_email, _password);
            if (result is not null)
            {
                await AuthProvider.LoginAsync(result.Token);
                Nav.NavigateTo("/", forceLoad: true);
            }
            else
            {
                _error = "Invalid email or password.";
            }
        }
        catch
        {
            _error = "Invalid email or password.";
        }
        finally { _loading = false; }
    }
}
