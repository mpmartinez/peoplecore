@page "/reset-password"
@layout PeopleCore.Web.Components.Layout.EmptyLayout
@inject NavigationManager Nav

@*
    Setting a new password from an emailed link. The token comes from the query string and is
    dropped from the address bar once read, so it does not sit in browser history.

    Query parsing uses QueryHelpers.ParseQuery rather than [SupplyParameterFromQuery]: that
    attribute is populated by the Router when it instantiates a routed component, but this page (like
    its tests) can also be rendered directly without a Router in the tree, where the attribute would
    never be supplied. Parsing Nav.Uri here works either way.
*@

<div class="min-h-screen flex items-center justify-center bg-muted/30">
    <Card Class="w-full max-w-sm">
        <CardHeader>
            <CardTitle Class="text-2xl text-center">Set a new password</CardTitle>
        </CardHeader>
        <CardContent>
            @if (_token is null)
            {
                <Alert Variant="destructive" data-link-error>
                    This link has expired or has already been used. Ask for a new one.
                </Alert>
                <p class="text-sm text-center mt-6">
                    <a class="text-primary hover:underline" href="/forgot-password">Ask for a new link</a>
                </p>
            }
            else
            {
                <ChangePasswordForm ResetEmail="@_email" ResetToken="@_token"
                                    SubmitText="Set Password" OnChanged="Done" />
                <p class="text-sm text-center mt-6">
                    <a class="text-primary hover:underline" href="/forgot-password">Ask for a new link</a>
                </p>
            }
        </CardContent>
    </Card>
</div>

@code {
    private string? _email;
    private string? _token;

    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _email = query.TryGetValue("email", out var email) ? email.ToString() : null;
        _token = query.TryGetValue("token", out var token) && !string.IsNullOrWhiteSpace(token)
            ? token.ToString()
            : null;

        // Held in fields from here on, so the address bar does not need to carry it. OnInitialized
        // runs once per component instance, and nothing below re-reads the query string, so the
        // replace-navigation stripping it does not lose _email/_token.
        if (_token is not null) Nav.NavigateTo("/reset-password", replace: true);
    }

    private void Done() => Nav.NavigateTo("/login?reset=1");
}
