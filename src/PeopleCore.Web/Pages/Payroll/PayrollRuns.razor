@page "/payroll-runs"
@attribute [RequirePermission(Permissions.PayrollManage)]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Payroll Runs</PageTitle>

<PageHeader Title="Payroll Runs" Section="Payroll" Description="Every pay period, from draft through to posting.">
    <Actions>
        <Button Variant="primary" OnClick="OpenCreateDialog">
            <i class="bi bi-plus-lg mr-1"></i> Create Run
        </Button>
    </Actions>
</PageHeader>

<Card>
    <CardContent Class="p-0">
        @if (_runs is null)
        {
            @if (_error is not null)
            {
                <div class="p-6">
                    <Alert Variant="destructive" Title="Couldn't load payroll runs">@_error</Alert>
                    <Button Variant="outline" Size="sm" Class="mt-3" OnClick="LoadRuns">Retry</Button>
                </div>
            }
            else
            {
                <div class="p-6 flex justify-center"><Spinner /></div>
            }
        }
        else if (!_runs.Items.Any())
        {
            <div class="p-6 text-center text-muted-foreground text-sm">No payroll runs yet.</div>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Run Number</TableHead>
                        <TableHead Class="px-4">Period</TableHead>
                        <TableHead Class="px-4">Pay Date</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4">Employees</TableHead>
                        <TableHead Class="px-4">Total Net Pay</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var r in _runs.Items)
                    {
                        <TableRow @onclick="() => GoToRun(r.Id)">
                            <TableCell Class="px-4 py-3 font-medium cursor-pointer">
                                @r.RunNumber
                                @if (r.RunType == PayrollLabels.FinalPayRunType)
                                {
                                    <Badge Variant="outline" Class="ml-2" data-final-pay-badge>Final pay</Badge>
                                }
                                @if (r.IncludesLeaveConversion)
                                {
                                    <Badge Variant="outline" Class="ml-2" data-leave-conversion-badge>Leave conversion</Badge>
                                }
                                @* A final pay always includes the 13th month, so the badge would say nothing. *@
                                @if (r.IncludesThirteenthMonth && r.RunType != PayrollLabels.FinalPayRunType)
                                {
                                    <Badge Variant="outline" Class="ml-2" data-thirteenth-month-badge>13th month</Badge>
                                }
                            </TableCell>
                            <TableCell Class="px-4 py-3 cursor-pointer">@r.PeriodLabel</TableCell>
                            <TableCell Class="px-4 py-3 cursor-pointer">@r.PayDate</TableCell>
                            <TableCell Class="px-4 py-3 cursor-pointer">
                                <Badge Variant="@PayrollLabels.RunStatusVariant(r.Status)">@PayrollLabels.RunStatusOf(r.Status)</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3 cursor-pointer">@r.EmployeeCount</TableCell>
                            <TableCell Class="px-4 py-3 cursor-pointer">&#8369;@r.TotalNetPay.ToString("N2")</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        }
    </CardContent>
    @if (_runs is not null && _runs.TotalPages > 1)
    {
        <CardFooter>
            <Pagination CurrentPage="@_page" TotalPages="@_runs.TotalPages" OnPageChange="@HandlePage" />
        </CardFooter>
    }
</Card>

<Dialog IsOpen="@_showCreateDialog" Title="Create Payroll Run"
        Description="Period dates, pay date and the employees to include. Days worked, overtime and holiday pay are always derived from attendance."
        OnClose="CloseCreateDialog" Size="lg" BodyClass="space-y-4">
    <ChildContent>
    <div class="grid grid-cols-2 gap-3">
        <FormField LabelText="Period Start" Id="periodStart" Required="true">
            <Input TValue="DateOnly" Id="periodStart" Type="date" @bind-Value="_form.PeriodStart" />
        </FormField>
        <FormField LabelText="Period End" Id="periodEnd" Required="true">
            <Input TValue="DateOnly" Id="periodEnd" Type="date" @bind-Value="_form.PeriodEnd" />
        </FormField>
        <FormField LabelText="Pay Date" Id="payDate" Required="true">
            <Input TValue="DateOnly" Id="payDate" Type="date" @bind-Value="_form.PayDate" />
        </FormField>
        <FormField LabelText="Frequency" Id="frequency" Required="true">
            <Select TValue="string" Id="frequency" @bind-Value="_form.Frequency">
                <option value="Monthly">Monthly</option>
                <option value="SemiMonthly">Semi-Monthly</option>
            </Select>
        </FormField>
    </div>

    <fieldset class="space-y-2" data-year-end-pay>
        <legend class="text-sm font-medium">Year-end pay</legend>
        @* Offered for every period: a 13th month paid early is an advance, and the one paid later
           in the year nets it out. *@
        <div class="space-y-1">
            <Checkbox @bind-Value="_form.IncludeThirteenthMonth" data-thirteenth-month>Include 13th month</Checkbox>
            <p class="ml-6 text-xs text-muted-foreground">Pays each eligible employee's 13th month on this payroll, less any part already paid this year.</p>
            <p class="ml-6 text-xs text-muted-foreground" data-thirteenth-month-due>Due by Dec 24 (PD 851).</p>
        </div>
        @* The API takes year-end leave conversion only on a December payroll, so the box is offered
           only while the period ends in December; a tick left behind by an earlier period end isn't sent.
           It starts ticked when the period ends on Dec 31 - the year's last payroll is where unused
           leave is paid out, and an earlier cutoff (Dec 1-15) would convert leave the rest of December
           can still use - and stays as the user leaves it. *@
        @if (EndsInDecember)
        {
            <div class="space-y-1">
                <Checkbox @bind-Value="_form.IncludeLeaveConversion" data-leave-conversion>Convert unused leave</Checkbox>
                <p class="ml-6 text-xs text-muted-foreground">Pays out each employee's unused year-end leave (such as SIL) in cash on this payroll.</p>
            </div>
        }
    </fieldset>

    <div>
        <div class="flex items-center justify-between">
            <Label Required="true">Employees</Label>
            @if (!_loadingEmployees && _activeEmployees.Count > 0)
            {
                <div class="flex gap-1">
                    <Button Variant="link" Size="sm" Class="h-auto p-0 text-xs" OnClick="SelectAllEmployees">Select all</Button>
                    <span class="text-xs text-muted-foreground">&middot;</span>
                    <Button Variant="link" Size="sm" Class="h-auto p-0 text-xs" OnClick="ClearAllEmployees">Clear all</Button>
                </div>
            }
        </div>
        @if (_loadingEmployees)
        {
            <div class="p-4 flex justify-center"><Spinner Size="sm" /></div>
        }
        else if (_employeesLoadFailed)
        {
            <div class="p-4 text-sm text-muted-foreground">Employees could not be loaded.</div>
        }
        else if (_activeEmployees.Count == 0)
        {
            <div class="p-4 text-sm text-muted-foreground">No active employees found.</div>
        }
        else
        {
            <div class="border rounded-md max-h-64 overflow-y-auto p-2 space-y-1 mt-1">
                @foreach (var e in _activeEmployees)
                {
                    <Checkbox Value="@_selectedEmployeeIds.Contains(e.Id)"
                              ValueChanged="@(v => ToggleEmployee(e.Id, v))">
                        @e.FullName <span class="text-muted-foreground text-xs">(@e.EmployeeNumber)</span>
                    </Checkbox>
                    @* Offered only to an employee on the run whose maternity claim is ready to advance (a
                       Draft claim with an allowance that no run carries yet); the API refuses anyone else. *@
                    @if (_maternityReadyIds.Contains(e.Id) && _selectedEmployeeIds.Contains(e.Id))
                    {
                        <div class="ml-6 space-y-1" data-maternity-advance>
                            <Checkbox Value="@_advanceMaternityIds.Contains(e.Id)"
                                      ValueChanged="@(v => ToggleAdvance(e.Id, v))" data-advance-maternity="@e.Id">
                                Advance maternity benefit
                            </Checkbox>
                            <p class="ml-6 text-xs text-muted-foreground" data-maternity-net-cash-note>@MaternityLabels.NetCashNote</p>
                        </div>
                    }
                }
            </div>
            <div class="text-xs text-muted-foreground mt-1">@_selectedEmployeeIds.Count selected of @_activeEmployees.Count active employees</div>
            @if (_maternityReadyError is not null)
            {
                <div class="text-xs text-muted-foreground mt-1" data-maternity-ready-error>Couldn't check who has a maternity benefit ready to advance: @_maternityReadyError</div>
            }
        }
    </div>

    @if (_createError is not null)
    {
        <Alert Variant="destructive">@_createError</Alert>
    }
    </ChildContent>

    <FooterContent>
        <div class="flex justify-end gap-2">
            <Button Variant="outline" OnClick="CloseCreateDialog">Cancel</Button>
            <Button Variant="primary" OnClick="CreateRun" Loading="@_creating" Disabled="@_creating">Create</Button>
        </div>
    </FooterContent>
</Dialog>

@code {
    private PagedResult<PayrollRunSummaryDto>? _runs;
    private int _page = 1;
    private string? _error;

    private bool _showCreateDialog;
    private bool _loadingEmployees;
    // After a failed employee load nobody knows whether there are active employees, so neither
    // "none found" nor a "0 selected of 0" count is shown; _createError carries the failure.
    private bool _employeesLoadFailed;
    private bool _creating;
    private string? _createError;
    private List<EmployeeListDto> _activeEmployees = [];
    private HashSet<Guid> _selectedEmployeeIds = [];
    private CreateRunFormModel _form = new();

    // The employees whose maternity benefit this run can advance, and those it will.
    private HashSet<Guid> _maternityReadyIds = [];
    private HashSet<Guid> _advanceMaternityIds = [];
    // A failed check only means no advance is offered; the run itself can still be created.
    private string? _maternityReadyError;
    // Bumped each time the dialog opens, so an earlier opening's answers still in flight are dropped.
    private int _dialogVersion;

    protected override async Task OnInitializedAsync() => await LoadRuns();

    private void GoToRun(Guid id) => Nav.NavigateTo($"/payroll-runs/{id}");

    private async Task HandlePage(int page) { _page = page; await LoadRuns(); }

    // A failed load shows its error in place of the list; while _runs is null the card would
    // otherwise sit on its spinner forever. Clearing the error first shows the spinner again
    // while a Retry is in flight. The runs are dropped on failure as well, so a failed move to
    // another page cannot leave the previous page's runs on screen looking like that page's -
    // and Retry reloads the page that failed.
    private async Task LoadRuns()
    {
        _error = null;
        try
        {
            _runs = await Api.GetPayrollRunsAsync(page: _page, pageSize: 50);
        }
        catch (Exception ex)
        {
            _runs = null;
            _error = ex.Message;
        }
    }

    private async Task OpenCreateDialog()
    {
        var version = ++_dialogVersion;
        _form = new CreateRunFormModel();
        _selectedEmployeeIds = [];
        _activeEmployees = [];
        _maternityReadyIds = [];
        _advanceMaternityIds = [];
        _maternityReadyError = null;
        _createError = null;
        _employeesLoadFailed = false;
        _showCreateDialog = true;
        _loadingEmployees = true;
        try
        {
            var employees = await LoadAllActiveEmployeesAsync();
            if (version != _dialogVersion) return;
            _activeEmployees = employees;
            // Spec default: the dialog starts with every active employee selected, with the
            // checklist above offered only to trim - not to build the list from scratch.
            _selectedEmployeeIds = _activeEmployees.Select(e => e.Id).ToHashSet();
        }
        catch (Exception ex)
        {
            if (version != _dialogVersion) return;
            _employeesLoadFailed = true;
            _createError = ex.Message;
        }
        finally
        {
            if (version == _dialogVersion) _loadingEmployees = false;
        }

        if (_employeesLoadFailed) return;
        try
        {
            var ready = await Api.GetMaternityReadyEmployeeIdsAsync();
            if (version != _dialogVersion) return;
            _maternityReadyIds = (ready ?? []).ToHashSet();
        }
        catch (Exception ex)
        {
            if (version != _dialogVersion) return;
            _maternityReadyError = ex.Message;
        }
    }

    private void CloseCreateDialog() => _showCreateDialog = false;

    private bool EndsInDecember => _form.PeriodEnd.Month == 12;

    // Taking an employee off the run clears their advance too, so putting them back doesn't bring
    // back a tick nobody can see was left on.
    private void ToggleEmployee(Guid employeeId, bool selected)
    {
        if (selected) _selectedEmployeeIds.Add(employeeId);
        else
        {
            _selectedEmployeeIds.Remove(employeeId);
            _advanceMaternityIds.Remove(employeeId);
        }
    }

    private void ToggleAdvance(Guid employeeId, bool advance)
    {
        if (advance) _advanceMaternityIds.Add(employeeId);
        else _advanceMaternityIds.Remove(employeeId);
    }

    private void SelectAllEmployees() => _selectedEmployeeIds = _activeEmployees.Select(e => e.Id).ToHashSet();

    private void ClearAllEmployees()
    {
        _selectedEmployeeIds.Clear();
        _advanceMaternityIds.Clear();
    }

    // GetEmployeesAsync is paged with a default pageSize of 20. Taking page one alone would
    // silently create a payroll run missing every employee after the twentieth - a payday
    // nobody gets paid on, with no error anywhere - so page through to exhaustion instead.
    private async Task<List<EmployeeListDto>> LoadAllActiveEmployeesAsync()
    {
        var all = new List<EmployeeListDto>();
        var page = 1;
        while (true)
        {
            var result = await Api.GetEmployeesAsync(page, 100);
            if (result is null || result.Items.Count == 0) break;
            all.AddRange(result.Items.Where(e => e.IsActive));
            if (page >= result.TotalPages) break;
            page++;
        }
        return all;
    }

    private async Task CreateRun()
    {
        _createError = null;

        if (_form.PeriodEnd < _form.PeriodStart)
        {
            _createError = "Period end must be on or after period start.";
            return;
        }
        if (_selectedEmployeeIds.Count == 0)
        {
            _createError = "Select at least one employee.";
            return;
        }

        _creating = true;
        try
        {
            // DaysWorked, OvertimeHours and HolidayDays are deliberately omitted here (left null
            // on the server). Null tells the attendance bridge to derive them from punches,
            // approved leave, approved overtime, the holiday calendar and the shift schedule -
            // sending a zero would silently beat the derived figure and unpay overtime and
            // holiday premiums the employee actually earned. The 13th month is set per employee on
            // the API, and the one tick applies to everyone on the run. The maternity advance is
            // each employee's own, sent only for someone ready to advance and still on the run.
            var includeThirteenthMonth = _form.IncludeThirteenthMonth;
            var (run, error) = await Api.CreatePayrollRunAsync(new
            {
                periodStart = _form.PeriodStart.ToString("yyyy-MM-dd"),
                periodEnd = _form.PeriodEnd.ToString("yyyy-MM-dd"),
                payDate = _form.PayDate.ToString("yyyy-MM-dd"),
                frequency = _form.Frequency,
                employees = _selectedEmployeeIds.Select(id => new
                {
                    employeeId = id,
                    includeThirteenthMonth,
                    advanceMaternityBenefit = _maternityReadyIds.Contains(id) && _advanceMaternityIds.Contains(id)
                }),
                includeLeaveConversion = EndsInDecember && _form.IncludeLeaveConversion
            });

            if (run is null)
            {
                _createError = error ?? "Failed to create payroll run. Please try again.";
                return;
            }

            _showCreateDialog = false;
            Nav.NavigateTo($"/payroll-runs/{run.Id}");
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _creating = false;
        }
    }


    private class CreateRunFormModel
    {
        public DateOnly PeriodStart { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly PeriodEnd { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly PayDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string Frequency { get; set; } = "Monthly";
        // Ticked for a period ending Dec 31 until the user unticks it, and unticked for any other
        // until they tick it; offered, and sent, only while the period ends in December.
        private bool? _leaveConversionChoice;
        public bool IncludeLeaveConversion
        {
            get => _leaveConversionChoice ?? PeriodEnd is { Month: 12, Day: 31 };
            set => _leaveConversionChoice = value;
        }
        public bool IncludeThirteenthMonth { get; set; }
    }
}
