@page "/government-reports"
@attribute [RequirePermission(Permissions.PayrollManage)]
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Government Reports</PageTitle>

<PageHeader Title="Government Reports" Section="Payroll"
            Description="Each month's SSS, PhilHealth, Pag-IBIG and BIR 1601-C figures, and the annual BIR 1604-C alphalist, from paid payroll runs.">
    <Actions>
        @if (HasData)
        {
            <Button Variant="outline" OnClick="DownloadCsv" Loading="@_downloading" Disabled="@_downloading" data-download-csv>
                <i class="bi bi-download mr-1"></i> Download CSV
            </Button>
        }
    </Actions>
</PageHeader>

<Card Class="mb-4">
    <CardContent Class="pt-6 flex flex-wrap items-end gap-4">
        @if (_tab == "1604c")
        {
            <div>
                <Label For="report-year">Year</Label>
                <input id="report-year" type="number" class="border rounded-md px-3 py-2 bg-background"
                       value="@_year" max="@DateTime.Today.Year" @onchange="ChangeYear" />
            </div>
        }
        else
        {
            <div>
                <Label For="report-month">Month</Label>
                <input id="report-month" type="month" class="border rounded-md px-3 py-2 bg-background"
                       value="@_month.ToString("yyyy-MM")" max="@DateTime.Today.ToString("yyyy-MM")" @onchange="ChangeMonth" />
            </div>
        }
        <div class="flex gap-2" role="tablist">
            @foreach (var (key, label) in Tabs)
            {
                <Button Size="sm" Variant="@(key == _tab ? "primary" : "outline")" data-tab="@key"
                        role="tab" aria-selected="@(key == _tab ? "true" : "false")"
                        OnClick="@(() => SelectTab(key))">@label</Button>
            }
        </div>
    </CardContent>
</Card>

@if (_error is not null)
{
    <Alert Variant="destructive" Class="mb-4">@_error</Alert>
}
else if (_loading)
{
    <p class="text-sm text-muted-foreground">Loading…</p>
}
else if (_report is not null)
{
    @if (_downloadError is not null)
    {
        <Alert Variant="destructive" Class="mb-4" data-download-error>@_downloadError</Alert>
    }

    <div class="mb-4 text-sm">
        <p class="font-semibold">@_report.Employer.Name</p>
        <p class="text-muted-foreground">@_report.Title · @_report.Basis · TIN @_report.Employer.Tin
            @if (_report.Report != "1601c") { <span> · Employer no. @_report.Employer.AgencyNumber</span> }</p>
    </div>

    @if (_report.Warnings.Count > 0)
    {
        <Alert Class="mb-4" data-report-warnings>
            <ul class="list-disc pl-4">@foreach (var w in _report.Warnings) { <li>@w</li> }</ul>
        </Alert>
    }

    @if (_tab == "1604c")
    {
        <p data-alphalist-note>Payroll makes no year-end tax adjustment yet. "To collect / (refund)" is what's left to settle, for example in December's pay; a negative amount is a refund.</p>
    }

    @if ((_report.Sections?.Count ?? 0) > 0)
    {
        @if (!HasData)
        {
            <p class="text-sm text-muted-foreground" data-report-empty>No payroll was paid in @_year.</p>
        }
        else
        {
            @foreach (var section in _report.Sections!)
            {
                <section class="mb-6" data-report-section>
                    <h3 class="font-semibold mb-2">@section.Title</h3>
                    @if (section.Rows.Count == 0)
                    {
                        <p class="text-sm text-muted-foreground" data-section-empty>@section.EmptyMessage</p>
                    }
                    else
                    {
                        <GovernmentReportTable Columns="@section.Columns" Rows="@section.Rows" Totals="@section.Totals" />
                    }
                </section>
            }
        }
    }
    else if (_report.Rows.Count == 0)
    {
        <p class="text-sm text-muted-foreground" data-report-empty>No payroll was paid for @_month.ToString("MMMM yyyy").</p>
    }
    else
    {
        <GovernmentReportTable Columns="@_report.Columns" Rows="@_report.Rows" Totals="@_report.Totals" />

        @if (_report.Summary.Count > 0)
        {
            <table class="mt-6 text-sm" data-report-summary>
                @foreach (var line in _report.Summary)
                {
                    <tr><td class="pr-6 py-1">@line.Label</td><td class="text-right">@line.Amount.ToString("N2")</td></tr>
                }
            </table>
        }
    }
}

@code {
    private static readonly (string Key, string Label)[] Tabs =
        [("sss", "SSS"), ("philhealth", "PhilHealth"), ("pagibig", "Pag-IBIG"), ("1601c", "BIR 1601-C"), ("1604c", "BIR 1604-C")];

    // Remittances are for the month just ended.
    private DateTime _month = new(DateTime.Today.AddMonths(-1).Year, DateTime.Today.AddMonths(-1).Month, 1);
    // The 1604-C alphalist is annual and defaults to last year - this year's runs are still open.
    private int _year = DateTime.Today.Year - 1;
    private string _tab = "sss";
    private GovernmentReportDto? _report;
    private bool _loading, _downloading;
    private string? _error;
    private string? _downloadError;

    // True once the loaded report has something to show: either the top-level table (monthly
    // reports) or at least one non-empty section (the 1604-C alphalist). Drives both the Download
    // CSV button and, for a sectioned report, whether "No payroll was paid" replaces the sections.
    // Sections is null-guarded: an older API mid-deploy can answer with no "sections" field at all
    // (see GetJsonAsync/ApiClient), which System.Text.Json leaves as null rather than an empty list.
    private bool HasData => _report is not null &&
        (_report.Rows.Count > 0 || (_report.Sections?.Any(s => s.Rows.Count > 0) ?? false));

    // Guards against a slow earlier tab/month request resolving after a later one and
    // overwriting its (more current) result: each LoadAsync call claims the next number, and
    // only the call that is still the latest when it completes is allowed to apply what it got.
    private int _loadSequence;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SelectTab(string key)
    {
        _tab = key;
        await LoadAsync();
    }

    private async Task ChangeMonth(ChangeEventArgs e)
    {
        if (DateTime.TryParse($"{e.Value}-01", out var month))
        {
            _month = month;
            await LoadAsync();
        }
    }

    private async Task ChangeYear(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year))
        {
            _year = year;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var sequence = ++_loadSequence;
        _loading = true;
        _error = null;
        _downloadError = null;
        try
        {
            var report = _tab == "1604c"
                ? await Api.GetGovernmentReportAsync(_tab, _year, null)
                : await Api.GetGovernmentReportAsync(_tab, _month.Year, _month.Month);
            if (sequence != _loadSequence) return; // a later tab/month/year change has since started; drop this stale result
            _report = report;
        }
        catch (HttpRequestException ex)
        {
            if (sequence != _loadSequence) return;
            _report = null;
            _error = ex.Message;
        }
        finally
        {
            if (sequence == _loadSequence) _loading = false;
        }
    }

    private async Task DownloadCsv()
    {
        // Captured before the await: if a tab, month or year change lands while the download is
        // in flight, the file name still matches the report that was actually downloaded.
        var (tab, month, year) = (_tab, _month, _year);
        _downloading = true;
        _downloadError = null;
        try
        {
            var isAnnual = tab == "1604c";
            var csv = isAnnual
                ? await Api.GetGovernmentReportCsvAsync(tab, year, null)
                : await Api.GetGovernmentReportCsvAsync(tab, month.Year, month.Month);
            var fileName = isAnnual ? $"{tab}-{year}.csv" : $"{tab}-{month:yyyy-MM}.csv";
            await JS.InvokeVoidAsync("downloadFileFromBytes", Convert.ToBase64String(csv), fileName, "text/csv");
        }
        catch (HttpRequestException ex)
        {
            // A download failure is about the CSV, not the report already on screen - keep that
            // report visible and show this as its own alert, rather than routing it through
            // _error and having the "@if (_error) / else if (_report)" chain above replace the
            // whole page with the banner.
            _downloadError = ex.Message;
        }
        finally
        {
            _downloading = false;
        }
    }
}
